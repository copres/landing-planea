---
import { getTranslations, getLocaleFromPath, getLocalizedRoutes } from '../../i18n/utils.js';

// Detectar locale desde la URL usando la función centralizada
const locale = getLocaleFromPath(Astro.url.pathname);
const t = getTranslations(locale);

// Rutas localizadas
const routes = getLocalizedRoutes(locale);
const homePath = routes.home || '/es/';
---

<div class="mt-12 pt-8 border-t border-primary-200 dark:border-primary-800 text-center">
    <h3 class="text-2xl font-bold tracking-tight text-primary-900 dark:text-primary-100 sm:text-3xl mb-6">
        {t.cta?.shared?.title || '¿Listo para digitalizar tu constructora?'}
    </h3>
    <p
      class="mb-8 text-lg leading-8 text-primary-600 dark:text-primary-400"
      set:html={
        t.cta?.shared?.description?.replace(
          /metroKUBIKO/g,
          `<a href="${homePath}" class="text-blue-600 dark:text-cyan-400 hover:text-blue-400 dark:hover:text-cyan-300">metroKUBIKO</a>`
        ) ||
        `Únete a las empresas constructoras que ya gestionan sus proyectos con <a href="${homePath}" class="text-blue-600 dark:text-cyan-400 hover:text-blue-400 dark:hover:text-cyan-300">metroKUBIKO</a>.`
      }
    />
    <a
        href="https://plataforma.metrokubiko.com/laura?src=%2Fregistro.html"
        class="bg-metroKUBIKO-naranja hover:bg-metroKUBIKO-naranja/90 focus-visible:outline-metroKUBIKO-naranja inline-flex items-center justify-center rounded-full border border-transparent px-5 py-3 text-base font-medium text-white transition focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2"
    >
        {t.cta?.shared?.button || 'Comienza ahora - Pruébalo gratis'}
    </a>
</div>
