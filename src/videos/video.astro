    const hlCycle = (t, cat) => {
      const order = { wall: 0, col: 1, slab: 2, door: 3 };
      const st = 2.2 + order[cat] * 1.15;
      return span(t, st, st + 0.35) * (1 - 0.55 * span(t, st + 1.15, st + 1.5));
