            g.beginPath();
            g.arc(L.x, L.y, L.r + 30, 0, TAU);
            g.stroke();
            g.strokeStyle = prog < 1 ? HEX.orange : HEX.green;
            g.beginPath();
            g.arc(L.x, L.y, L.r + 30, -Math.PI / 2, -Math.PI / 2 + TAU * prog);
            g.stroke();
            label(prog < 1 ? `Analizando · ${Math.round(prog * 100)}%` : '✓ Análisis completo',
              L.x, 742, FONT.mono(600, 24), prog < 1 ? HEX.text : HEX.green, 'center');
          });

          const chain = ['Cantidades', '48 actividades', '48 APUs'];
          g.font = FONT.mono(600, 23);
          const widths = chain.map(s => g.measureText(s).width);
          const gap = 70;
          let x = 1260 - (widths.reduce((a, b) => a + b, 0) + gap * 2) / 2;
          chain.forEach((s, i) => {
            const on = span(t, 2.2 + i * 1.3, 2.6 + i * 1.3);
            alpha(fade * (0.25 + 0.75 * on), () => {
              label(s, x, 826, FONT.mono(600, 23), on > 0.5 ? HEX.amber : HEX.dim);
              if (i < 2) {
                g.strokeStyle = on > 0.5 ? HEX.orange : 'rgba(255,255,255,0.2)';
                g.lineWidth = 2;
                g.beginPath();
                g.moveTo(x + widths[i] + 16, 818);
                g.lineTo(x + widths[i] + gap - 16, 818);
                g.lineTo(x + widths[i] + gap - 24, 812);
                g.moveTo(x + widths[i] + gap - 16, 818);
                g.lineTo(x + widths[i] + gap - 24, 824);
                g.stroke();
              }
            });
            x += widths[i] + gap;
          });
        }
      },

      // 6 · PASO 4: PRESUPUESTO
      {
        dur: 8,
        step: 4,
        form: bars(budgetStatic),
        enter: { at: 0, len: 2.2 },
        draw(t, T, dur) {
          story(t, dur, 'PASO 04', 'Tu *presupuesto*',
            'Organizado por capítulos, con sus actividades, APUs y el total estimado de tu obra, listo para revisar.');
          const { vals, grow, flash } = budgetStatic(t);
          budgetLabels(t, 1 - span(t, dur - 0.7, dur - 0.3), vals, grow, flash, easeOut(span(t, 1.0, 2.8)));
          alpha(span(t, 2.6, 3.0) * (1 - span(t, dur - 0.7, dur - 0.3)), () =>
            label('COP / USD', 1750, 300, FONT.mono(600, 20), HEX.orange, 'right'));
        }
      },

      // 7 · PASO 5: CRONOGRAMA
      {
        dur: 8,
        step: 5,
        form: gantt,
        enter: { at: 0, len: 1.8 },
        draw(t, T, dur) {
          story(t, dur, 'PASO 05', 'Tu *cronograma*',
            'Arranca en la fecha de inicio que indicaste y marca la ruta crítica (CPM): las actividades que no pueden retrasarse.');
          const fade = 1 - span(t, dur - 0.7, dur - 0.3);

          alpha(span(t, 0.4, 0.9) * fade, () => {
            for (let d = 0; d <= 60; d += 10) {
              g.fillStyle = 'rgba(255, 255, 255, 0.05)';
              g.fillRect(dayX(d), 316, 1, 480);
            }
            [[0, '1 ENE 2027', 'left'], [31, '1 FEB', 'center'], [59, '1 MAR', 'right']].forEach(([d, s, al]) =>
              label(s, dayX(d), 300, FONT.mono(500, 19), HEX.dim, al));
          });

          CHAPTERS.forEach((ch, b) => {
            const y = rowY(b);
            alpha(span(t, 0.8 + b * 0.25, 1.3 + b * 0.25) * fade, () => {
              label(`0${b + 1}  ${ch.name}`, dayX(ch.s), y - 24, FONT.mono(500, 19), HEX.dim);
              label(`${ch.e - ch.s} d`, dayX(ch.e) + 16, y + 8, FONT.mono(600, 22), ch.crit ? HEX.amber : HEX.cyan);
            });
            if (ch.float) alpha(span(t, 3.4, 3.9) * fade, () => {
              g.setLineDash([6, 6]);
              g.strokeStyle = 'rgba(94, 234, 212, 0.5)';
              g.lineWidth = 1.5;
              rounded(dayX(ch.e) + 70, y - 12, dayX(ch.float) - dayX(ch.e), 24, 6);
              g.stroke();
              g.setLineDash([]);
            });
          });

          // Ruta crítica
          const path = [];
          const crit = CHAPTERS.map((c, b) => ({ ...c, b })).filter(c => c.crit);
          crit.forEach((c, j) => {
            path.push([dayX(c.s), rowY(c.b)], [dayX(c.e), rowY(c.b)]);
            if (j < crit.length - 1) path.push([dayX(c.e), rowY(crit[j + 1].b)]);
          });
          const p = easeInOut(span(t, 2.8, 4.6));
          if (p > 0) alpha(fade, () => {
            let total = 0;
            for (let k = 1; k < path.length; k++) total += Math.hypot(path[k][0] - path[k - 1][0], path[k][1] - path[k - 1][1]);
            let left = total * p;
            g.save();
            g.shadowColor = HEX.orange;
            g.shadowBlur = 16;
            g.strokeStyle = '#FFE2CC';
            g.lineWidth = 2.5;
            g.beginPath();
            g.moveTo(path[0][0], path[0][1]);
            for (let k = 1; k < path.length && left > 0; k++) {
              const [ax, ay] = path[k - 1], [bx, by] = path[k];
              const l = Math.hypot(bx - ax, by - ay);
              const f = Math.min(1, left / l);
              g.lineTo(mix(ax, bx, f), mix(ay, by, f));
              left -= l;
            }
            g.stroke();
            g.restore();
