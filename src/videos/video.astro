    ];

    // ================================================================
    //  FONDO Y HUD
    // ================================================================
    function backdrop(T) {
      const base = g.createLinearGradient(0, 0, 0, H);
      base.addColorStop(0, '#070A11');
      base.addColorStop(1, '#0B1020');
      g.fillStyle = base;
      g.fillRect(0, 0, W, H);

      const orb = (x, y, r, rgba) => {
        const grd = g.createRadialGradient(x, y, 0, x, y, r);
        grd.addColorStop(0, rgba);
        grd.addColorStop(1, 'rgba(0, 0, 0, 0)');
        g.fillStyle = grd;
        g.fillRect(x - r, y - r, r * 2, r * 2);
      };
      orb(1300 + Math.sin(T * 0.13) * 220, 480 + Math.cos(T * 0.11) * 140, 760, 'rgba(255, 106, 26, 0.09)');
      orb(380 + Math.cos(T * 0.09) * 160, 820 + Math.sin(T * 0.12) * 80, 680, 'rgba(59, 130, 246, 0.07)');
      orb(1650 + Math.sin(T * 0.07) * 120, 960, 520, 'rgba(167, 139, 250, 0.05)');

      // Plano de referencia en perspectiva (estilo plano técnico)
      g.save();
      g.strokeStyle = 'rgba(255, 255, 255, 0.035)';
      g.lineWidth = 1;
      const vx = 960, vy = 600;
      for (let k = -14; k <= 14; k++) {
        g.beginPath();
        g.moveTo(vx + k * 18, vy + 60);
        g.lineTo(vx + k * 180, H);
        g.stroke();
      }
      const drift = (T * 0.25) % 1;
      for (let k = 0; k < 9; k++) {
        const f = (k + drift) / 9;
        const y = vy + 60 + Math.pow(f, 2.2) * (H - vy - 60);
        g.beginPath();
        g.moveTo(0, y);
        g.lineTo(W, y);
        g.stroke();
      }
      g.restore();
    }

    function vignette() {
      const v = g.createRadialGradient(W / 2, H / 2, H * 0.35, W / 2, H / 2, H * 1.05);
      v.addColorStop(0, 'rgba(0, 0, 0, 0)');
      v.addColorStop(1, 'rgba(0, 0, 0, 0.55)');
      g.fillStyle = v;
      g.fillRect(0, 0, W, H);
    }

    function hud(scene, t, T) {
      g.font = FONT.display(600, 26);
      const w1 = g.measureText('metroKUBIKO').width;
      label('metroKUBIKO', 150, 110, FONT.display(600, 26), 'rgba(243, 245, 249, 0.85)');
      label('Planea', 150 + w1 + 10, 110, FONT.display(700, 26), HEX.orange);

      if (scene.step) {
        const a = span(t, 0, 0.5) * (1 - span(t, scene.dur - 0.4, scene.dur));
        alpha(Math.max(a, 0.25), () => {
          label(`PASO 0${scene.step} / 0${STEPS}`, 1770, 110, FONT.mono(600, 20), HEX.text, 'right');
          for (let s = 0; s < STEPS; s++) {
            const x = 1770 - (STEPS - s) * 44 + 8;
            g.fillStyle = 'rgba(255, 255, 255, 0.12)';
            g.fillRect(x, 128, 36, 3);
            const f = s + 1 < scene.step ? 1 : s + 1 === scene.step ? t / scene.dur : 0;
            if (f > 0) { g.fillStyle = HEX.orange; g.fillRect(x, 128, 36 * f, 3); }
          }
        });
      }

      g.fillStyle = 'rgba(255, 255, 255, 0.06)';
      g.fillRect(0, H - 4, W, 4);
      g.fillStyle = HEX.orange;
      g.fillRect(0, H - 4, W * (T / TOTAL), 4);
    }

    // ================================================================
    //  RENDER
    // ================================================================
    const PX = new Float32Array(N), PY = new Float32Array(N), PZ = new Float32Array(N);
    const PA = new Float32Array(N), PS = new Float32Array(N);
    const PR = new Uint8ClampedArray(N), PG = new Uint8ClampedArray(N), PB = new Uint8ClampedArray(N);
    const A = {}, B = {};
    const reset = o => { o.z = 1; return o; };

    function solveParticles(T, idx, t) {
      const sc = scenes[idx];
      const prev = idx > 0 ? scenes[idx - 1] : null;
      const prevForm = prev ? prev.form : nebula;
      const tPrev = prev ? t + prev.dur : t;
      const en = sc.enter ?? { at: 0, len: 1.8 };
      const travel = Math.max(0.6, en.len - 0.75);

      for (let i = 0; i < N; i++) {
        const p = DNA[i];
        const k = easeInOut(span(t, en.at + p.lag, en.at + p.lag + travel));
        sc.form(i, T, t, reset(A));
        let x = A.x, y = A.y, z = A.z, a = A.a, s = A.s;
        let r = A.rgb[0], gg = A.rgb[1], b = A.rgb[2];
        if (k < 1) {
          prevForm(i, T, tPrev, reset(B));
          const dx = A.x - B.x, dy = A.y - B.y;
          const len = Math.hypot(dx, dy) || 1;
          const arc = Math.sin(Math.PI * k) * p.swirl * Math.min(1, len / 300);
          x = mix(B.x, A.x, k) - (dy / len) * arc;
          y = mix(B.y, A.y, k) + (dx / len) * arc;
          z = k < 0.5 ? B.z : A.z;
          a = mix(B.a, A.a, k);
          s = mix(B.s, A.s, k);
          r = mix(B.rgb[0], A.rgb[0], k);
          gg = mix(B.rgb[1], A.rgb[1], k);
          b = mix(B.rgb[2], A.rgb[2], k);
        }
        PX[i] = x; PY[i] = y; PZ[i] = z; PA[i] = a; PS[i] = s;
        PR[i] = r; PG[i] = gg; PB[i] = b;
      }
    }

    function drawParticles(front) {
      g.save();
      g.globalCompositeOperation = 'lighter';
      for (let i = 0; i < N; i++) {
        if ((PZ[i] >= 0) !== front) continue;
        const col = `${PR[i]},${PG[i]},${PB[i]}`;
        if (i % 2 === 0) {
          g.fillStyle = `rgba(${col},${PA[i] * 0.09})`;
          g.beginPath();
          g.arc(PX[i], PY[i], PS[i] * 3.4, 0, TAU);
          g.fill();
        }
        g.fillStyle = `rgba(${col},${PA[i]})`;
        g.beginPath();
        g.arc(PX[i], PY[i], PS[i], 0, TAU);
        g.fill();
      }
      g.restore();
    }

    function render(T) {
      let idx = scenes.findIndex(s => T < s.start + s.dur);
      if (idx < 0) idx = scenes.length - 1;
      const sc = scenes[idx];
      const t = T - sc.start;

      backdrop(T);
      solveParticles(T, idx, t);

      const intro = span(T, 0, 1.2);
      alpha(intro, () => {
        drawParticles(false);
        drawLaura(lauraAt(T), T);
        drawParticles(true);
      });
      sc.draw(t, T, sc.dur);
      vignette();
      hud(sc, t, T);

      const outro = span(T, TOTAL - 0.9, TOTAL);
      if (outro > 0) {
        g.fillStyle = `rgba(5, 7, 11, ${outro})`;
        g.fillRect(0, 0, W, H);
      }
    }

    // ================================================================
    //  REPRODUCTOR
    // ================================================================
    const $ = id => document.getElementById(id);
    const ui = { toggle: $('toggle'), again: $('again'), track: $('track'), fill: $('fill'), clock: $('clock'), rec: $('rec') };
    const player = { T: 0, playing: true, last: 0, recorder: null, chunks: [] };
    const clockFmt = s => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    function setPlaying(on) {
      player.playing = on;
      ui.toggle.textContent = on ? '❚❚' : '▶';
      ui.toggle.setAttribute('aria-label', on ? 'Pausar' : 'Reproducir');
    }

    function tick(now) {
      const dt = player.last ? Math.min(0.1, (now - player.last) / 1000) : 0;
      player.last = now;
      if (player.playing) {
        player.T += dt;
        if (player.T >= TOTAL) {
          if (player.recorder) finishRecording();
          player.T %= TOTAL;
        }
      }
      render(player.T);
      const f = player.T / TOTAL;
      ui.fill.style.width = `${f * 100}%`;
      ui.track.setAttribute('aria-valuenow', String(Math.round(f * 100)));
      ui.clock.textContent = `${clockFmt(player.T)} / ${clockFmt(TOTAL)}`;
      if (player.recorder) ui.rec.textContent = `Grabando ${Math.round(f * 100)}%`;
      requestAnimationFrame(tick);
    }

    const scrub = e => {
      if (player.recorder) return;
      const r = ui.track.getBoundingClientRect();
      player.T = clamp((e.clientX - r.left) / r.width) * TOTAL * 0.9999;
    };
    ui.track.addEventListener('pointerdown', e => {
      scrub(e);
      ui.track.setPointerCapture(e.pointerId);
      ui.track.onpointermove = scrub;
    });
    ui.track.addEventListener('pointerup', () => { ui.track.onpointermove = null; });
    ui.track.addEventListener('keydown', e => {
      if (player.recorder) return;
      if (e.key === 'ArrowRight') player.T = Math.min(TOTAL - 0.01, player.T + 5);
      if (e.key === 'ArrowLeft') player.T = Math.max(0, player.T - 5);
    });
    ui.toggle.addEventListener('click', () => setPlaying(!player.playing));
    ui.again.addEventListener('click', () => { if (!player.recorder) { player.T = 0; setPlaying(true); } });
    film.addEventListener('click', () => { if (!player.recorder) setPlaying(!player.playing); });
    window.addEventListener('keydown', e => {
      if (e.code === 'Space' && e.target === document.body && !player.recorder) {
        e.preventDefault();
        setPlaying(!player.playing);
      }
    });

    // Exportación a .webm grabando el lienzo en tiempo real
    function startRecording() {
      const type = ['video/webm;codecs=vp9', 'video/webm;codecs=vp8', 'video/webm']
        .find(m => window.MediaRecorder && MediaRecorder.isTypeSupported(m));
      if (!film.captureStream || !type) {
        alert('Este navegador no permite exportar el video. Prueba con Chrome o Edge.');
        return;
      }
      player.chunks = [];
      const rec = new MediaRecorder(film.captureStream(60), { mimeType: type, videoBitsPerSecond: 12000000 });
      rec.ondataavailable = e => { if (e.data.size) player.chunks.push(e.data); };
      rec.onstop = () => {
        const url = URL.createObjectURL(new Blob(player.chunks, { type: 'video/webm' }));
        const a = document.createElement('a');
        a.href = url;
        a.download = 'planea-como-funciona.webm';
        a.click();
        setTimeout(() => URL.revokeObjectURL(url), 3000);
      };
      player.T = 0;
      setPlaying(true);
      player.recorder = rec;
      ui.toggle.disabled = ui.again.disabled = true;
      rec.start();
    }

    function finishRecording() {
      player.recorder.stop();
      player.recorder = null;
      ui.toggle.disabled = ui.again.disabled = false;
      ui.rec.textContent = 'Exportar .webm';
    }

    ui.rec.addEventListener('click', () => { if (!player.recorder) startRecording(); });

    // ================================================================
    //  ARRANQUE
    // ================================================================
    const loadImage = (src, cors) => new Promise((resolve, reject) => {
      const img = new Image();
      if (cors) img.crossOrigin = 'anonymous';
      img.onload = () => resolve(img);
      img.onerror = reject;
      img.src = src;
    });

    const canExport = img => {
      try {
        const c = document.createElement('canvas');
        c.width = c.height = 2;
        const x = c.getContext('2d');
        x.drawImage(img, 0, 0, 2, 2);
        x.getImageData(0, 0, 1, 1);
        return true;
      } catch (err) {
        return false;
      }
    };

    async function boot() {
      const fonts = [
        FONT.display(400, 40), FONT.display(600, 40), FONT.display(700, 40),
        FONT.body(500, 30), FONT.body(600, 30), FONT.mono(500, 20), FONT.mono(600, 20)
      ].map(f => document.fonts.load(f));
      await Promise.race([Promise.all(fonts), new Promise(r => setTimeout(r, 3500))]);

      WORD_INTRO = sampleText('Planea', 960, 545, 300);
      WORD_OUTRO = sampleText('Planea', 960, 580, 220);

      try { lauraImg = await loadImage(LAURA_URL, true); }
      catch (err) {
        try { lauraImg = await loadImage(LAURA_URL, false); } catch (err2) { lauraImg = null; }
      }
      if (lauraImg && !canExport(lauraImg)) {
        ui.rec.disabled = true;
        ui.rec.title = 'La imagen de Laura no tiene CORS habilitado, así que el navegador no permite exportar el lienzo.';
      }

      requestAnimationFrame(tick);
    }

    boot();
  })();
  </script>
</body>
</html>
