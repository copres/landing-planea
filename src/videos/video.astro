<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Planea en movimiento</title>
  <meta name="description" content="Qué es metroKUBIKO Planea y cómo funciona: del modelo BIM al presupuesto y cronograma de obra con Laura, el agente de IA.">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=Manrope:wght@500;600&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">

  <style>
    :root {
      --ink: #05070B;
      --line: rgba(255, 255, 255, 0.10);
      --text: #E8ECF2;
      --muted: #8A93A6;
      --accent: #FF6A1A;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; }
    body {
      background: radial-gradient(1200px 700px at 50% 40%, #0E1322 0%, var(--ink) 70%);
      color: var(--text);
      font-family: 'Manrope', sans-serif;
      display: grid;
      place-items: center;
      overflow-x: hidden;
    }
    .stage {
      width: min(1440px, calc(100vw - 32px), calc((100vh - 96px) * 16 / 9));
      display: grid;
      gap: 14px;
    }
    canvas {
      width: 100%;
      aspect-ratio: 16 / 9;
      display: block;
      border-radius: 18px;
      background: #070A11;
      box-shadow: 0 0 0 1px var(--line), 0 40px 120px rgba(0, 0, 0, 0.6), 0 0 120px rgba(255, 106, 26, 0.06);
      cursor: pointer;
    }
    .bar {
      display: flex;
      align-items: center;
      gap: 14px;
      font: 500 13px 'JetBrains Mono', monospace;
      color: var(--muted);
    }
    .bar button {
      all: unset;
      cursor: pointer;
      height: 36px;
      min-width: 36px;
      padding: 0 14px;
      display: inline-grid;
      place-items: center;
      border-radius: 999px;
      border: 1px solid var(--line);
      color: var(--text);
      font: 600 13px 'JetBrains Mono', monospace;
      white-space: nowrap;
      transition: border-color .2s, background .2s;
    }
    .bar button:hover { border-color: rgba(255, 106, 26, 0.6); background: rgba(255, 106, 26, 0.08); }
    .bar button:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .bar button[disabled] { opacity: .4; cursor: not-allowed; }
    .bar #rec { margin-left: auto; color: var(--accent); border-color: rgba(255, 106, 26, 0.4); }
    .track {
      position: relative;
      flex: 1;
      height: 36px;
      display: flex;
      align-items: center;
      cursor: pointer;
    }
    .track::before {
      content: "";
      position: absolute;
      inset: 17px 0;
      background: var(--line);
      border-radius: 2px;
    }
    .track i {
      position: absolute;
      left: 0;
      top: 17px;
      height: 2px;
      background: linear-gradient(90deg, #FF6A1A, #FFB36B);
      border-radius: 2px;
      box-shadow: 0 0 12px rgba(255, 106, 26, 0.7);
    }
    @media (max-width: 640px) {
      .bar { gap: 8px; }
      .bar #clock { display: none; }
      .bar button { padding: 0 10px; }
    }
  </style>
</head>
<body>
  <main class="stage">
    <canvas id="film" width="1920" height="1080" aria-label="Video animado: qué es metroKUBIKO Planea y cómo funciona, paso a paso, con Laura"></canvas>
    <div class="bar">
      <button id="toggle" type="button" aria-label="Pausar">❚❚</button>
      <button id="again" type="button" aria-label="Volver a empezar">↺</button>
      <div class="track" id="track" role="slider" aria-label="Línea de tiempo" tabindex="0"><i id="fill"></i></div>
      <span id="clock">0:00 / 0:00</span>
      <button id="rec" type="button">Exportar .webm</button>
    </div>
  </main>

  <script is:inline>
  (() => {
    // ================================================================
    //  LIENZO Y CONSTANTES
    // ================================================================
    const film = document.getElementById('film');
    const g = film.getContext('2d');
    const W = 1920, H = 1080, TAU = Math.PI * 2;
    const N = 1700;
    const LAURA_URL = 'https://firebasestorage.googleapis.com/v0/b/copres-firebase.appspot.com/o/CoPres%2Flaura%2Fprofile-2.png?alt=media&token=af875745-5d70-4d56-9c78-cddd27880410';

    const RGB = {
      orange: [255, 106, 26],
      amber: [255, 179, 107],
      white: [226, 232, 240],
      steel: [148, 163, 184],
      cyan: [94, 234, 212],
      blue: [96, 165, 250],
      green: [52, 211, 153],
      violet: [167, 139, 250]
    };
    const HEX = {
      text: '#F3F5F9',
      body: '#9AA3B5',
      dim: '#6F7890',
      orange: '#FF6A1A',
      amber: '#FFB36B',
      green: '#34D399',
      cyan: '#5EEAD4'
    };
    const FONT = {
      display: (w, s) => `${w} ${s}px Sora, sans-serif`,
      body: (w, s) => `${w} ${s}px Manrope, sans-serif`,
      mono: (w, s) => `${w} ${s}px "JetBrains Mono", monospace`
    };

    // ================================================================
    //  MATEMÁTICA
    // ================================================================
    const clamp = (v, a = 0, b = 1) => v < a ? a : v > b ? b : v;
    const span = (t, a, b) => clamp((t - a) / (b - a));
    const mix = (a, b, k) => a + (b - a) * k;
    const easeOut = k => 1 - Math.pow(1 - k, 4);
    const easeInOut = k => k < 0.5 ? 8 * k * k * k * k : 1 - Math.pow(-2 * k + 2, 4) / 2;
    const money = v => '$' + Math.round(v).toLocaleString('en-US');

    function seeded(seed) {
      return () => {
        seed = (seed + 0x6D2B79F5) | 0;
        let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
        t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
        return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
      };
    }
    const rand = seeded(20270101);
    const shuffle = arr => {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(rand() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    };

    // Cada partícula tiene su propia "personalidad" determinista
    const DNA = Array.from({ length: N }, () => ({
      a: rand(), b: rand(), c: rand(), d: rand(),
      lag: rand() * 0.75,
      swirl: (rand() - 0.5) * 320,
      size: 1.2 + rand() * 1.9
    }));

    // ================================================================
    //  DATOS DEL PROYECTO DE EJEMPLO
    // ================================================================
    const CHAPTERS = [
      { name: 'Preliminares', v: 6200, s: 0, e: 6, crit: true },
      { name: 'Cimentación', v: 14500, s: 6, e: 16, crit: true },
      { name: 'Estructura en concreto', v: 38200, s: 16, e: 40, crit: true },
      { name: 'Mampostería y muros', v: 19400, s: 28, e: 48, crit: false, float: 54 },
      { name: 'Acabados y pisos', v: 27300, s: 40, e: 60, crit: true }
    ];
    const BASE_TOTAL = CHAPTERS.reduce((s, c) => s + c.v, 0);
    const rowY = b => 372 + b * 100;
    const BAR_X = 900, BAR_SCALE = 700 / 42800;
    const dayX = d => 900 + (d / 60) * 800;

    // Reparto fijo de partículas por capítulo, proporcional al valor inicial
    const BAR_OF = new Uint8Array(N);
    {
      let acc = 0, b = 0;
      const cuts = CHAPTERS.map(c => (acc += c.v / BASE_TOTAL));
      for (let i = 0; i < N; i++) {
        while ((i + 0.5) / N > cuts[b]) b++;
        BAR_OF[i] = b;
      }
    }

    // ================================================================
    //  GEOMETRÍA DEL MODELO BIM (puntos 3D con categoría)
    // ================================================================
    const BIM = [];
    {
      const add = (x, y, z, cat) => BIM.push({ x, y, z, cat });
      const seg = (x1, y1, z1, x2, y2, z2, step, cat) => {
        const len = Math.hypot(x2 - x1, y2 - y1, z2 - z1);
        const n = Math.max(1, Math.round(len / step));
        for (let k = 0; k <= n; k++) add(mix(x1, x2, k / n), mix(y1, y2, k / n), mix(z1, z2, k / n), cat);
      };
      const rectXY = (x1, x2, y1, y2, z, step, cat) => {
        seg(x1, y1, z, x2, y1, z, step, cat); seg(x2, y1, z, x2, y2, z, step, cat);
        seg(x2, y2, z, x1, y2, z, step, cat); seg(x1, y2, z, x1, y1, z, step, cat);
      };
      const rectZY = (z1, z2, y1, y2, x, step, cat) => {
        seg(x, y1, z1, x, y1, z2, step, cat); seg(x, y1, z2, x, y2, z2, step, cat);
        seg(x, y2, z2, x, y2, z1, step, cat); seg(x, y2, z1, x, y1, z1, step, cat);
      };
      for (let k = 0; k <= 5; k++) {
        seg(-2, k, -1.5, 2, k, -1.5, 0.14, 'slab'); seg(2, k, -1.5, 2, k, 1.5, 0.14, 'slab');
        seg(2, k, 1.5, -2, k, 1.5, 0.14, 'slab'); seg(-2, k, 1.5, -2, k, -1.5, 0.14, 'slab');
        if (k > 0) for (let x = -1.5; x <= 1.5; x += 0.75) for (let z = -1; z <= 1; z += 0.66) add(x, k, z, 'slab');
      }
      [[-2, -1.5], [0, -1.5], [2, -1.5], [-2, 1.5], [0, 1.5], [2, 1.5], [-2, 0], [2, 0]]
        .forEach(([x, z]) => seg(x, 0, z, x, 5, z, 0.13, 'col'));
      for (let f = 0; f < 5; f++) {
        for (const x of [-1.5, -0.5, 0.5, 1.5]) {
          if (f === 0 && Math.abs(x) < 1) continue;
          rectXY(x - 0.22, x + 0.22, f + 0.3, f + 0.75, 1.5, 0.16, 'wall');
          rectXY(x - 0.22, x + 0.22, f + 0.3, f + 0.75, -1.5, 0.16, 'wall');
        }
        for (const z of [-0.75, 0.75]) {
          rectZY(z - 0.22, z + 0.22, f + 0.3, f + 0.75, 2, 0.16, 'wall');
          rectZY(z - 0.22, z + 0.22, f + 0.3, f + 0.75, -2, 0.16, 'wall');
        }
      }
      rectXY(-0.32, 0.32, 0, 0.85, 1.5, 0.08, 'door');
      rectXY(-0.32, 0.32, 0, 0.85, -1.5, 0.08, 'door');
      shuffle(BIM);
    }
    const CAT_RGB = { wall: RGB.blue, col: RGB.orange, slab: RGB.green, door: RGB.violet };

    // ================================================================
    //  MUESTREO DE TEXTO A PUNTOS
    // ================================================================
    function sampleText(text, cx, cy, size) {
      const off = document.createElement('canvas');
      off.width = W; off.height = H;
      const o = off.getContext('2d');
      o.font = FONT.display(700, size);
      o.textAlign = 'center';
      o.textBaseline = 'middle';
      o.fillStyle = '#fff';
      o.fillText(text, cx, cy);
      const m = o.measureText(text);
      const data = o.getImageData(0, 0, W, H).data;
      const pts = [];
      const step = 4;
      for (let y = 0; y < H; y += step) {
        for (let x = 0; x < W; x += step) {
          if (data[(y * W + x) * 4 + 3] > 140) pts.push([x, y]);
        }
      }
      shuffle(pts);
      const left = cx - m.width / 2;
      pts.forEach(p => { p[2] = clamp((p[0] - left) / m.width); });
      return pts;
    }
    let WORD_INTRO = [[W / 2, H / 2, 0]], WORD_OUTRO = [[W / 2, H / 2, 0]];

    // ================================================================
    //  LAURA: TRAYECTORIA A LO LARGO DEL VIDEO
    // ================================================================
    let lauraImg = null;
    let LAURA_KEYS = [];
    const lauraNow = { x: 0, y: 0, r: 0, a: 0 };
    function lauraAt(T) {
      const K = LAURA_KEYS;
      if (!K.length) return lauraNow;
      let i = 0;
      while (i < K.length - 2 && T > K[i + 1].T) i++;
      const A = K[i], B = K[i + 1];
      const k = easeInOut(span(T, A.T, B.T));
      lauraNow.x = mix(A.x, B.x, k);
      lauraNow.y = mix(A.y, B.y, k);
      lauraNow.r = mix(A.r, B.r, k);
      lauraNow.a = mix(A.a, B.a, k);
      return lauraNow;
    }

    // ================================================================
    //  FORMACIONES DE PARTÍCULAS
    //  f(i, T, t, out) escribe x, y, z, rgb, a, s
    // ================================================================
    const nebula = (i, T, t, o) => {
      const p = DNA[i];
      const r = 40 + Math.pow(p.a, 0.6) * 600;
      const ang = p.b * TAU + T * 0.28 * (260 / (r + 160));
      o.x = 960 + Math.cos(ang) * r * 1.4;
      o.y = 540 + Math.sin(ang) * r * 0.48 + (p.c - 0.5) * 40;
      o.rgb = r < 220 ? RGB.amber : r < 420 ? RGB.orange : RGB.steel;
      o.a = 0.35 + 0.6 * p.c;
      o.s = p.size;
    };

    const word = getPts => (i, T, t, o) => {
      const pts = getPts();
      const q = pts[i % pts.length];
      const p = DNA[i];
      o.x = q[0] + Math.sin(T * 1.4 + p.a * 30) * 1.4;
      o.y = q[1] + Math.cos(T * 1.2 + p.b * 30) * 1.4;
      o.rgb = q[2] < 0.5 ? RGB.orange : RGB.amber;
      o.a = 0.75 + 0.25 * p.c;
      o.s = 1.4 + p.d * 1.1;
    };

    const building = opts => (i, T, t, o) => {
      const q = BIM[i % BIM.length];
      const p = DNA[i];
      const S = 92, cx = 1290, cy = 560, tilt = 0.42;
      const th = T * 0.22 + 0.6;
      const c = Math.cos(th), s = Math.sin(th);
      const x1 = q.x * c - q.z * s;
      const z1 = q.x * s + q.z * c;
      const y = q.y - 2.5;
      const y2 = y * Math.cos(tilt) - z1 * Math.sin(tilt);
      const z2 = y * Math.sin(tilt) + z1 * Math.cos(tilt);
      const persp = 1100 / (1100 + z2 * S);
      o.x = cx + x1 * S * persp;
      o.y = cy - y2 * S * persp;
      const depth = clamp(0.5 - z2 / 6);
      o.a = 0.3 + 0.7 * depth;
      o.s = p.size * persp * (q.cat === 'col' ? 1.15 : 1);
      o.rgb = q.cat === 'col' ? RGB.amber : RGB.white;
      if (opts && opts.hl) {
        const w = opts.hl(t, q.cat);
        if (w > 0) { o.rgb = CAT_RGB[q.cat]; o.a = Math.min(1, o.a + 0.4 * w); o.s *= 1 + 0.5 * w; }
      }
      if (opts && opts.scan) {
        const sy = opts.scan(t);
        if (sy != null && Math.abs(q.y - sy) < 0.22) { o.rgb = RGB.orange; o.a = 1; o.s *= 1.7; }
      }
    };

    const orbit = opts => (i, T, t, o) => {
      const L = lauraAt(T);
      const p = DNA[i];
      const base = Math.max(L.r, 30);
      let R = base * 1.3 + 30 + Math.pow(p.a, 1.4) * 250;
      if (opts && opts.pulse) R *= 1 + 0.07 * Math.sin(T * 5 - p.a * 9) * opts.pulse(t);
      const ang = p.b * TAU + T * (0.16 + 0.34 * (1 - p.a));
      const sn = Math.sin(ang);
      const x = Math.cos(ang) * R;
      const y = sn * R * 0.34 + (p.d - 0.5) * 26;
      const rot = -0.28;
      o.x = L.x + x * Math.cos(rot) - y * Math.sin(rot);
      o.y = L.y + x * Math.sin(rot) + y * Math.cos(rot);
      o.z = sn;
      o.rgb = p.c < 0.6 ? RGB.orange : p.c < 0.85 ? RGB.amber : RGB.white;
      o.a = 0.3 + 0.7 * (sn * 0.5 + 0.5);
      o.s = p.size * (0.75 + 0.45 * (sn * 0.5 + 0.5));
    };

    const bars = valuesAt => (i, T, t, o) => {
      const b = BAR_OF[i], p = DNA[i];
      const { vals, grow, flash } = valuesAt(t);
      const len = vals[b] * BAR_SCALE * grow[b];
      o.x = BAR_X + p.a * len;
      o.y = rowY(b) + (p.b - 0.5) * 26 + Math.sin(T * 2 + p.c * 20) * 1.2;
      o.rgb = p.a < 0.5 ? RGB.orange : RGB.amber;
      if (flash[b] > 0.4) o.rgb = RGB.white;
      o.a = 0.6 + 0.4 * p.c;
      o.s = 1.2 + p.d * 1.3;
    };

    const gantt = (i, T, t, o) => {
      const b = BAR_OF[i], p = DNA[i], ch = CHAPTERS[b];
      const grow = easeOut(span(t, 0.6 + b * 0.25, 2.0 + b * 0.25));
      const x0 = dayX(ch.s), x1 = dayX(ch.e);
      o.x = x0 + p.a * (x1 - x0) * Math.max(grow, 0.02);
      o.y = rowY(b) + (p.b - 0.5) * 22 + Math.sin(T * 2 + p.c * 20) * 1.2;
      o.rgb = ch.crit ? (p.a < 0.5 ? RGB.orange : RGB.amber) : RGB.cyan;
      o.a = 0.6 + 0.4 * p.c;
      o.s = 1.2 + p.d * 1.3;
    };

    // ================================================================
    //  PRIMITIVAS DE DIBUJO
    // ================================================================
    function alpha(a, fn) {
      if (a <= 0.001) return;
      g.save();
      g.globalAlpha *= clamp(a);
      fn();
      g.restore();
    }

    function rounded(x, y, w, h, r) {
      r = Math.min(r, w / 2, h / 2);
      g.beginPath();
      g.moveTo(x + r, y);
      g.arcTo(x + w, y, x + w, y + h, r);
      g.arcTo(x + w, y + h, x, y + h, r);
      g.arcTo(x, y + h, x, y, r);
      g.arcTo(x, y, x + w, y, r);
      g.closePath();
    }

    function glass(x, y, w, h, r, glow) {
      rounded(x, y, w, h, r);
      g.fillStyle = 'rgba(255, 255, 255, 0.045)';
      g.fill();
      g.lineWidth = 1.5;
      g.strokeStyle = glow ? 'rgba(255, 106, 26, 0.55)' : 'rgba(255, 255, 255, 0.14)';
      g.stroke();
    }

    function label(s, x, y, font, color, align = 'left', base = 'alphabetic') {
      g.font = font;
      g.fillStyle = color;
      g.textAlign = align;
      g.textBaseline = base;
      g.fillText(s, x, y);
    }

    // Texto cinético: cada palabra emerge desde una máscara y sale hacia arriba.
    // Las palabras entre *asteriscos* se resaltan.
    function parseWords(text) {
      let hot = false;
      return text.split(' ').map(raw => {
        let t = raw;
        if (t.startsWith('*')) { hot = true; t = t.slice(1); }
        const h = hot;
        if (t.includes('*')) { t = t.replace('*', ''); hot = false; }
        return { t, hot: h };
      });
    }

    function layoutWords(words, maxW, font) {
      g.font = font;
      const space = g.measureText(' ').width;
      const lines = [];
      let line = [], w = 0;
      for (const wd of words) {
        wd.w = g.measureText(wd.t).width;
        if (line.length && w + space + wd.w > maxW) { lines.push(line); line = []; w = 0; }
        if (line.length) w += space;
        wd.x = w;
        w += wd.w;
        line.push(wd);
      }
      if (line.length) lines.push(line);
      lines.forEach(l => { l.width = l[l.length - 1].x + l[l.length - 1].w; });
      return lines;
    }

    function kinetic(text, x, y, o) {
      const lines = layoutWords(parseWords(text), o.maxW ?? 1800, o.font);
      let j = 0;
      lines.forEach((ln, li) => {
        const ly = y + li * o.lh;
        const lx = o.align === 'center' ? x - ln.width / 2 : x;
        ln.forEach(wd => {
          const st = (o.delay ?? 0) + j * (o.stagger ?? 0.04);
          const outSt = o.out != null ? o.out + j * 0.012 : null;
          j++;
          const k = easeOut(span(o.t, st, st + 0.8));
          if (k <= 0) return;
          const out = outSt != null ? easeInOut(span(o.t, outSt, outSt + 0.45)) : 0;
          if (out >= 1) return;
          g.save();
          g.beginPath();
          g.rect(lx + wd.x - 10, ly - o.size * 1.05, wd.w + 20, o.size * 1.5);
          g.clip();
          g.globalAlpha *= k * (1 - out);
          label(wd.t, lx + wd.x, ly + (1 - k) * o.size * 1.1 - out * o.size * 0.7,
            o.font, wd.hot ? (o.hot ?? HEX.orange) : o.color);
          g.restore();
        });
      });
      return y + (lines.length - 1) * o.lh;
    }

    function typed(text, t, cps) {
      return text.slice(0, Math.max(0, Math.floor(t * cps)));
    }

    // Bloque editorial a la izquierda: etiqueta, título y explicación
    function story(t, dur, tag, title, body) {
      const out = dur - 0.75;
      alpha(easeOut(span(t, 0.05, 0.6)) * (1 - span(t, out, out + 0.4)), () => {
        const k = easeOut(span(t, 0.05, 0.8));
        g.fillStyle = HEX.orange;
        g.fillRect(150, 300, 44 * k, 3);
        label(tag, 210, 309, FONT.mono(600, 21), HEX.orange);
      });
      const tb = kinetic(title, 150, 410, {
        font: FONT.display(700, 76), size: 76, lh: 86, maxW: 700, t,
        delay: 0.2, stagger: 0.07, color: HEX.text, out
      });
      return kinetic(body, 150, tb + 74, {
        font: FONT.body(500, 31), size: 31, lh: 46, maxW: 640, t,
        delay: 0.6, stagger: 0.018, color: HEX.body, out: out + 0.05
      });
    }

    function ifcChip(x, y, name, a) {
      alpha(a, () => {
        g.font = FONT.mono(600, 24);
