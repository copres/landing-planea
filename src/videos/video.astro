      flash: [0, 0, 0, 0, 0]
    });
    const budgetEdit = t => {
      const vals = CHAPTERS.map(c => c.v);
      vals[2] = mix(38200, 42800, easeInOut(span(t, 2.5, 3.3)));
      vals[3] = mix(19400, 20150, easeInOut(span(t, 6.7, 7.5)));
      const flash = [0, 0, 0, 0, 0];
      flash[2] = span(t, 2.4, 2.6) * (1 - span(t, 3.8, 4.4));
      flash[3] = span(t, 6.6, 6.8) * (1 - span(t, 8.0, 8.6));
      return { vals, grow: [1, 1, 1, 1, 1], flash };
    };

    const scenes = [
      // 0 · APERTURA
