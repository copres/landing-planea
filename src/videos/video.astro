        });
      });
      const total = vals.reduce((s, v) => s + v, 0);
      const hot = Math.max(...flash);
      alpha(a * span(t, 1.8, 2.3), () => {
        g.fillStyle = 'rgba(255, 255, 255, 0.10)';
