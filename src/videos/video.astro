      });
    }

    function drawLaura(L, T) {
      if (L.r < 1 || L.a <= 0.01) return;
      alpha(L.a, () => {
        const { x, y, r } = L;
        const halo = g.createRadialGradient(x, y, r * 0.6, x, y, r * 2.4);
        halo.addColorStop(0, 'rgba(255, 106, 26, 0.28)');
        halo.addColorStop(1, 'rgba(255, 106, 26, 0)');
        g.fillStyle = halo;
        g.beginPath();
        g.arc(x, y, r * 2.4, 0, TAU);
        g.fill();

        if (g.createConicGradient) {
          const ring = g.createConicGradient(T * 1.3, x, y);
          ring.addColorStop(0, 'rgba(255, 106, 26, 0)');
          ring.addColorStop(0.55, 'rgba(255, 106, 26, 0.95)');
          ring.addColorStop(0.8, 'rgba(255, 179, 107, 1)');
          ring.addColorStop(1, 'rgba(255, 106, 26, 0)');
          g.strokeStyle = ring;
        } else {
          g.strokeStyle = 'rgba(255, 106, 26, 0.8)';
        }
        g.lineWidth = Math.max(2, r * 0.035);
        g.beginPath();
        g.arc(x, y, r + r * 0.09, 0, TAU);
        g.stroke();

        g.save();
        g.beginPath();
        g.arc(x, y, r, 0, TAU);
        g.clip();
        if (lauraImg) {
          const iw = lauraImg.naturalWidth, ih = lauraImg.naturalHeight, s = Math.min(iw, ih);
          g.drawImage(lauraImg, (iw - s) / 2, (ih - s) * 0.3, s, s, x - r, y - r, r * 2, r * 2);
        } else {
          g.fillStyle = '#1A2030';
          g.fillRect(x - r, y - r, r * 2, r * 2);
          label('L', x, y + 2, FONT.display(700, Math.round(r)), HEX.orange, 'center', 'middle');
        }
        g.restore();
        g.lineWidth = 1.5;
        g.strokeStyle = 'rgba(255, 255, 255, 0.18)';
        g.beginPath();
        g.arc(x, y, r, 0, TAU);
        g.stroke();
      });
    }

    function budgetLabels(t, a, vals, grow, flash, countUp) {
      CHAPTERS.forEach((ch, b) => {
        const y = rowY(b);
        alpha(a * span(t, 1.0 + b * 0.12, 1.5 + b * 0.12), () => {
          label(`0${b + 1}  ${ch.name}`, BAR_X, y - 26, FONT.mono(500, 19), HEX.dim);
