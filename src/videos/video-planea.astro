              fill: on ? C.orange : C.surface, stroke: on ? null : C.border, color: on ? '#FFFFFF' : C.sub
            });
            tx += tw[i] + 16;
          });

          // Valores con sus cambios
          const vals = CH.map(r => r.v);
          const k1 = ease.inOut(P(t, 2.3, 2.9)), k2 = P(t, 5.7, 5.8), k3 = ease.inOut(P(t, 8.8, 9.4));
          vals[2] = lerp(38200, 42800, k1);
          vals[4] = lerp(27300, 25900, k2);
          vals[3] = lerp(19400, 20150, k3);
          const flash = [0, 0, 0, 0, 0];
          flash[2] = P(t, 2.2, 2.4) * (1 - P(t, 3.2, 3.6));
          flash[4] = P(t, 5.7, 5.9) * (1 - P(t, 6.6, 7.0));
          flash[3] = P(t, 8.7, 8.9) * (1 - P(t, 10.2, 10.6));

          // Tarjeta de presupuesto
          card(880, 320, 890, 550);
          txt('Presupuesto', 920, 380, F.h(700, 32), C.main);
          txt('Se recalcula al instante', 1730, 380, F.m(500, 20), C.muted, 'right');
          CH.forEach((r, i) => {
            const y = 450 + i * 62;
            if (flash[i] > 0) withAlpha(flash[i], () => { rr(900, y - 28, 850, 56, 12); ctx.fillStyle = C.orangeL; ctx.fill(); });
            txt(r.n, 920, y + 1, F.b(500, 26), C.sub, 'left', 'middle');
            const editing = i === 4 && t > 4.9 && t < 5.75;
            if (editing) {
              rr(1530, y - 24, 210, 48, 8);
              ctx.fillStyle = C.surface;
              ctx.fill();
              ctx.strokeStyle = C.orange;
              ctx.lineWidth = 2.5;
              ctx.stroke();
              const typed = '25900'.slice(0, Math.floor((t - 5.0) * 10));
              txt(typed, 1720, y + 1, F.m(600, 26), C.main, 'right', 'middle');
            } else {
              txt(money(vals[i]), 1720, y + 1, F.m(600, 26), flash[i] > 0.3 ? C.orange : C.main, 'right', 'middle');
            }
          });
          ctx.fillStyle = C.border;
          ctx.fillRect(920, 760, 810, 2);
          txt('TOTAL ESTIMADO', 920, 815, F.m(600, 22), C.muted, 'left', 'middle');
          const totFlash = Math.max(...flash);
          txt(money(vals.reduce((a, b) => a + b, 0)), 1730, 815, F.h(700, 42), totFlash > 0.3 ? C.orange : C.main, 'right', 'middle');

          // Panel izquierdo según el modo
          card(150, 320, 680, 550);
          const fadeIn = s => P(t, s, s + 0.35);

          if (mode === 0) withAlpha(fadeIn(0) * (1 - P(t, 3.3, 3.6)), () => {
            drawLaura(205, 380, 30, { T });
            txt('Chat con Laura', 252, 381, F.h(700, 28), C.main, 'left', 'middle');
            const ua = P(t, 0.3, 0.5);
            withAlpha(ua, () => {
              card(300, 440, 500, 150, { r: 20, fill: C.soft, stroke: null, shadow: false });
              typeBlock('Cambia el precio del concreto a $42,800 y actualiza el presupuesto.', (t - 0.4) * 40,
                328, 492, 450, 38, F.b(500, 27), C.main, false);
            });
            withAlpha(P(t, 2.1, 2.4), () => {
              bubble(180, 630, 520, 120, { fill: C.orangeL, stroke: C.orangeB, shadow: false });
              txt('✦ Laura', 210, 672, F.m(600, 22), C.orange);
              txt('Hecho. Actualicé el concreto y el total.', 210, 716, F.b(600, 27), C.main);
            });
          });

          if (mode === 1) withAlpha(fadeIn(3.6) * (1 - P(t, 6.7, 7.0)), () => {
            txt('Edición manual', 190, 390, F.h(700, 30), C.main);
            wrap('Haz clic en cualquier celda del presupuesto y escribe el nuevo valor.', 600, F.b(500, 28))
              .forEach((l, i) => txt(l, 190, 450 + i * 42, F.b(500, 28), C.sub));
            // Mini celda ilustrativa
            card(190, 560, 600, 110, { r: 16, fill: '#F9FAFB', stroke: C.border, shadow: false });
            txt('05 Acabados y pisos', 220, 616, F.b(500, 26), C.sub, 'left', 'middle');
            txt(t > 5.75 ? '$25,900' : '$27,300', 760, 616, F.m(600, 26), t > 5.75 ? C.orange : C.main, 'right', 'middle');
            txt('Puedes editar cantidades, precios y APUs.', 190, 730, F.b(500, 24), C.muted);
          });

          if (mode === 2) withAlpha(fadeIn(7.0), () => {
            txt('Actualizar desde el IFC', 190, 390, F.h(700, 30), C.main);
            fileBadge(190, 425, 600, 80, 'torre_residencial_v2.ifc', 'Nuevo');
            // Icono de sincronización
            const spin = P(t, 7.4, 8.6);
            ctx.save();
            ctx.translate(490, 590);
            ctx.rotate(ease.inOut(spin) * Math.PI * 2);
            ctx.strokeStyle = spin < 1 ? C.orange : C.green;
            ctx.lineWidth = 6;
            ctx.lineCap = 'round';
            ctx.beginPath(); ctx.arc(0, 0, 34, 0.3, Math.PI - 0.3); ctx.stroke();
            ctx.beginPath(); ctx.arc(0, 0, 34, Math.PI + 0.3, Math.PI * 2 - 0.3); ctx.stroke();
            ctx.restore();
            withAlpha(P(t, 8.4, 8.8), () => {
              card(190, 660, 600, 80, { r: 14, fill: C.soft, stroke: null, shadow: false });
              txt('Muros', 220, 701, F.b(600, 26), C.main, 'left', 'middle');
              txt('1,840 → 1,910 m²', 760, 701, F.m(600, 26), C.blue, 'right', 'middle');
            });
            withAlpha(P(t, 9.2, 9.6), () => {
              check(205, 790, 15);
              txt('Mampostería recalculada', 232, 791, F.b(600, 26), C.green, 'left', 'middle');
            });
          });

          // Cursor del modo manual
          if (t > 3.7 && t < 6.6) {
            const m = ease.inOut(P(t, 3.9, 4.8));
            const cx = lerp(760, 1650, m), cy = lerp(780, 710, m);
            const pressed = t > 4.85 && t < 5.0;
            ctx.save();
            ctx.translate(cx, cy);
            if (pressed) ctx.scale(0.88, 0.88);
            ctx.beginPath();
            ctx.moveTo(0, 0); ctx.lineTo(0, 34); ctx.lineTo(9, 26); ctx.lineTo(16, 41);
            ctx.lineTo(22, 38); ctx.lineTo(15, 24); ctx.lineTo(26, 24); ctx.closePath();
            ctx.fillStyle = C.main;
            ctx.fill();
            ctx.strokeStyle = '#FFFFFF';
            ctx.lineWidth = 2.5;
            ctx.stroke();
            ctx.restore();
          }
        }
      },

      // 8. RESUMEN ----------------------------------------------
      {
        dur: 8,
        head: [{ t: 'Así funciona ' }, { t: 'Planea', o: 1 }],
        caps: [
          { at: 0.3, text: 'Entran tu modelo IFC y el contexto; Laura los analiza; salen tu presupuesto y tu cronograma.' },
          { at: 4.2, text: 'Y puedes seguir ajustándolos con Laura, manualmente o desde un nuevo IFC.' }
        ],
        draw(t, T) {
          const node = (cx, cy, label, sub, icon, a) => withAlpha(a, () => {
            const s = 0.9 + 0.1 * ease.back(a);
            ctx.save();
            ctx.translate(cx, cy);
            ctx.scale(s, s);
            card(-170, -78, 340, 156);
            icon(-110, 0);
            txt(label, -55, -8, F.h(700, 30), C.main, 'left', 'middle');
            txt(sub, -55, 30, F.m(500, 19), C.muted, 'left', 'middle');
            ctx.restore();
          });

          const iconIfc = (x, y) => fileIcon(x - 22, y - 30, 44, 58, 'IFC');
          const iconCtx = (x, y) => {
            rr(x - 28, y - 26, 56, 52, 12); ctx.fillStyle = C.greenL; ctx.fill();
            [-10, 2, 14].forEach((dy, i) => { ctx.fillStyle = C.green; ctx.fillRect(x - 16, y + dy - 3, i === 2 ? 20 : 32, 5); });
          };
          const iconBudget = (x, y) => {
            rr(x - 28, y - 28, 56, 56, 12); ctx.fillStyle = C.orangeL; ctx.fill();
            for (let i = 0; i < 4; i++) { ctx.fillStyle = i === 3 ? C.orange : '#FDBA8C'; ctx.fillRect(x - 17, y - 17 + i * 10, 34, 5); }
          };
          const iconGantt = (x, y) => {
            rr(x - 28, y - 28, 56, 56, 12); ctx.fillStyle = C.greenL; ctx.fill();
            [[-18, 16], [-6, 18], [4, 14]].forEach(([dx, w], i) => { rr(x + dx, y - 15 + i * 12, w, 7, 3); ctx.fillStyle = C.green; ctx.fill(); });
          };

          const L = [960, 555];
          flowCurve([[550, 430], [700, 430], [700, 555], [L[0] - 175, L[1] - 20]], P(t, 0.9, 1.6), C.orangeB, T);
          flowCurve([[550, 680], [700, 680], [700, 555], [L[0] - 175, L[1] + 20]], P(t, 1.1, 1.8), C.orangeB, T);
          flowCurve([[L[0] + 175, L[1] - 20], [1220, 555], [1220, 430], [1360, 430]], P(t, 2.4, 3.1), C.orangeB, T);
          flowCurve([[L[0] + 175, L[1] + 20], [1220, 555], [1220, 680], [1360, 680]], P(t, 2.6, 3.3), C.orangeB, T);

          node(380, 430, 'Modelo IFC', 'Tu modelo BIM', iconIfc, P(t, 0.3, 0.7));
          node(380, 680, 'Contexto', 'Ubicación y fecha', iconCtx, P(t, 0.6, 1.0));
          node(1540, 430, 'Presupuesto', 'Capítulos y APUs', iconBudget, P(t, 2.9, 3.3));
          node(1540, 680, 'Cronograma', 'Ruta crítica (CPM)', iconGantt, P(t, 3.1, 3.5));

          const la = ease.back(P(t, 1.4, 2.1));
          if (la > 0) {
            ctx.save();
            ctx.translate(L[0], L[1]);
            ctx.scale(la, la);
            drawLaura(0, 0, 110, { halo: t > 1.8 && t < 3.6, T });
            ctx.restore();
            withAlpha(P(t, 1.8, 2.2), () => txt('Laura IA', L[0], L[1] + 165, F.h(700, 32), C.main, 'center'));
          }

          // Ciclo de edición
          const lp = P(t, 4.0, 5.0);
          if (lp > 0) {
            flowCurve([[1540, 345], [1540, 250], [1100, 250], [L[0] + 40, L[1] - 160]], lp, C.green, T, { lw: 3, dash: [10, 10] });
            withAlpha(P(t, 4.6, 5.0), () => pill(1300, 268, 'Edita y actualiza',
              { fill: C.greenL, stroke: 'rgba(16, 185, 129, 0.35)', color: '#047857', h: 46 }));
          }
        }
      },

      // 9. CTA --------------------------------------------------
      {
        dur: 8,
        caps: [{ at: 0.6, text: 'Únete a la lista de espera de metroKUBIKO Planea.' }],
        draw(t, T) {
          const k = ease.back(P(t, 0, 0.8));
          if (k > 0) {
            ctx.save();
            ctx.translate(960, 320);
            ctx.scale(k, k);
            drawLaura(0, 0, 90, { T });
            ctx.restore();
          }
          withAlpha(P(t, 0.4, 0.9), () => wordmark(960, 500, 84));
          withAlpha(P(t, 0.9, 1.4), () =>
            segs([{ t: 'Del modelo BIM al ' }, { t: 'presupuesto y cronograma.', o: 1 }], 960, 600, F.h(700, 54)));
          withAlpha(P(t, 1.5, 2.0), () => {
            const pulse = 1 + 0.03 * Math.sin(T * 4);
            ctx.save();
            ctx.translate(960, 735);
            ctx.scale(pulse, pulse);
            ctx.save();
            ctx.shadowColor = 'rgba(255, 106, 26, 0.35)';
            ctx.shadowBlur = 34;
            ctx.shadowOffsetY = 12;
            rr(-360, -52, 720, 104, 52);
            ctx.fillStyle = C.orange;
            ctx.fill();
            ctx.restore();
            txt('UNIRME A LA LISTA DE ESPERA', 0, 2, F.h(700, 34), '#FFFFFF', 'center', 'middle');
            ctx.restore();
          });
        }
      }
    ];

    let acc = 0;
    scenes.forEach(s => { s.start = acc; acc += s.dur; });
    const TOTAL = acc;
    const STEPS = 6;

    // ----------------------------------------------------
    // MARCO PERSISTENTE (FONDO, BARRA SUPERIOR, SUBTÍTULOS)
    // ----------------------------------------------------
    function background() {
      ctx.fillStyle = C.bg;
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = 'rgba(0, 0, 0, 0.035)';
      for (let x = 0; x < W; x += 48) ctx.fillRect(x, 0, 1, H);
      for (let y = 0; y < H; y += 48) ctx.fillRect(0, y, W, 1);
      const g = ctx.createRadialGradient(W / 2, H * 0.45, 0, W / 2, H * 0.45, 900);
      g.addColorStop(0, 'rgba(255, 106, 26, 0.05)');
      g.addColorStop(1, 'rgba(255, 106, 26, 0)');
      ctx.fillStyle = g;
      ctx.fillRect(0, 0, W, H);
    }

    function topBar(scene, a) {
      ctx.save();
      ctx.font = F.h(500, 38);
      const w1 = ctx.measureText('metro').width;
      ctx.font = F.h(700, 38);
      const w2 = ctx.measureText('KUBIKO Planea').width;
      wordmark(72 + (w1 + w2) / 2, 92, 38);
      ctx.restore();

      if (scene.step) {
        withAlpha(a, () => {
          const label = `PASO ${scene.step} DE ${STEPS}`;
          ctx.font = F.m(600, 22);
          const lw = ctx.measureText(label).width;
          const w = 28 + lw + 24 + STEPS * 22 + 18;
          const x = W - 72 - w;
          rr(x, 54, w, 52, 26);
          ctx.fillStyle = C.surface;
          ctx.fill();
          ctx.strokeStyle = C.border;
          ctx.lineWidth = 2;
          ctx.stroke();
          txt(label, x + 28, 81, F.m(600, 22), C.orange, 'left', 'middle');
          for (let i = 0; i < STEPS; i++) {
            ctx.beginPath();
            ctx.arc(x + 28 + lw + 30 + i * 22, 80, 6, 0, Math.PI * 2);
            ctx.fillStyle = i < scene.step ? C.orange : C.borderFocus;
            ctx.fill();
          }
        });
      } else {
        withAlpha(a, () => pill(W - 72, 80, 'IA + MODELO BIM',
          { align: 'right', fill: C.orangeL, stroke: C.orangeB, color: C.orange, h: 52 }));
      }
    }

    function caption(text, a) {
      if (!text || a <= 0) return;
      const font = F.b(500, 34), lh = 46;
      const lines = wrap(text, 1480, font);
      ctx.font = font;
      const w = Math.max(...lines.map(l => ctx.measureText(l).width)) + 84;
      const h = lines.length * lh + 40;
      const x = (W - w) / 2, y = 1036 - h;
      withAlpha(a, () => {
        rr(x, y, w, h, 22);
        ctx.fillStyle = 'rgba(17, 24, 39, 0.92)';
        ctx.fill();
        lines.forEach((l, i) => txt(l, W / 2, y + 20 + lh * i + lh / 2 + 1, font, '#FFFFFF', 'center', 'middle'));
      });
    }

    function render(T) {
      ctx.save();
      ctx.setTransform(1, 0, 0, 1, 0, 0);
      ctx.globalAlpha = 1;
      background();

      const idx = scenes.findIndex(s => T < s.start + s.dur);
      const scene = idx === -1 ? scenes[scenes.length - 1] : scenes[idx];
      const t = T - scene.start;
      const a = Math.min(ease.out(P(t, 0, 0.5)), 1 - ease.inOut(P(t, scene.dur - 0.45, scene.dur)));

      topBar(scene, a);

      withAlpha(a, () => {
        ctx.translate(0, (1 - a) * 16);
        if (scene.head) segs(scene.head, W / 2, 192, F.h(700, 58));
        scene.draw(t, T);
      });

      const cap = [...scene.caps].reverse().find(c => t >= c.at);
      if (cap) caption(cap.text, a * ease.out(P(t, cap.at, cap.at + 0.4)));

      // Barra de progreso del video
      ctx.fillStyle = 'rgba(17, 24, 39, 0.06)';
      ctx.fillRect(0, H - 6, W, 6);
      ctx.fillStyle = C.orange;
      ctx.fillRect(0, H - 6, W * (T / TOTAL), 6);
      ctx.restore();
    }

    // ----------------------------------------------------
    // REPRODUCTOR
    // ----------------------------------------------------
    const ui = {
      play: document.getElementById('btn-play'),
      restart: document.getElementById('btn-restart'),
      seek: document.getElementById('seek'),
      time: document.getElementById('time'),
      download: document.getElementById('btn-download')
    };
    const state = { T: 0, playing: true, last: 0, recorder: null, chunks: [] };
    const fmtTime = s => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;

    function setPlaying(p) {
      state.playing = p;
      ui.play.textContent = p ? '❚❚' : '▶';
      ui.play.setAttribute('aria-label', p ? 'Pausar' : 'Reproducir');
    }

    function frame(now) {
      const dt = state.last ? Math.min(0.1, (now - state.last) / 1000) : 0;
      state.last = now;
      if (state.playing) {
        state.T += dt;
        if (state.T >= TOTAL) {
          if (state.recorder) stopRecording();
          state.T %= TOTAL;
        }
      }
      render(state.T);
      ui.seek.value = String(Math.round((state.T / TOTAL) * 1000));
      ui.time.textContent = `${fmtTime(state.T)} / ${fmtTime(TOTAL)}`;
      if (state.recorder) ui.download.textContent = `Grabando… ${Math.round((state.T / TOTAL) * 100)}%`;
      requestAnimationFrame(frame);
    }

    ui.play.addEventListener('click', () => setPlaying(!state.playing));
    cv.addEventListener('click', () => { if (!state.recorder) setPlaying(!state.playing); });
    ui.restart.addEventListener('click', () => { state.T = 0; setPlaying(true); });
    ui.seek.addEventListener('input', () => { if (!state.recorder) state.T = (Number(ui.seek.value) / 1000) * TOTAL; });
    window.addEventListener('keydown', e => {
      if (e.code === 'Space' && !state.recorder) { e.preventDefault(); setPlaying(!state.playing); }
    });

    // Grabación del lienzo a .webm (tiempo real)
    function startRecording() {
      const mime = ['video/webm;codecs=vp9', 'video/webm;codecs=vp8', 'video/webm']
        .find(m => window.MediaRecorder && MediaRecorder.isTypeSupported(m));
      if (!cv.captureStream || !mime) {
        alert('Tu navegador no permite grabar el video. Prueba con Chrome o Edge.');
        return;
      }
      state.chunks = [];
      const rec = new MediaRecorder(cv.captureStream(30), { mimeType: mime, videoBitsPerSecond: 8_000_000 });
      rec.ondataavailable = e => { if (e.data.size) state.chunks.push(e.data); };
      rec.onstop = () => {
        const url = URL.createObjectURL(new Blob(state.chunks, { type: 'video/webm' }));
        const link = document.createElement('a');
        link.href = url;
        link.download = 'metrokubiko-planea.webm';
        link.click();
        setTimeout(() => URL.revokeObjectURL(url), 2000);
      };
      state.T = 0;
      setPlaying(true);
      state.recorder = rec;
      ui.play.disabled = ui.restart.disabled = ui.seek.disabled = true;
      rec.start();
    }

    function stopRecording() {
      state.recorder.stop();
      state.recorder = null;
      ui.play.disabled = ui.restart.disabled = ui.seek.disabled = false;
      ui.download.textContent = 'Descargar video';
    }

    ui.download.addEventListener('click', () => { if (!state.recorder) startRecording(); });

    // ----------------------------------------------------
    // CARGA (FUENTES + IMAGEN DE LAURA) E INICIO
    // ----------------------------------------------------
    function loadImage(src, cors) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        if (cors) img.crossOrigin = 'anonymous';
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = src;
      });
    }

    function isTainting(img) {
      try {
        const c = document.createElement('canvas');
        c.width = c.height = 2;
        const g = c.getContext('2d');
        g.drawImage(img, 0, 0, 2, 2);
        g.getImageData(0, 0, 1, 1);
        return false;
      } catch {
        return true;
      }
    }

    async function init() {
      const fonts = [
        F.h(500, 40), F.h(700, 40), F.b(400, 30), F.b(500, 30), F.b(600, 30),
        F.m(500, 20), F.m(600, 20)
      ].map(f => document.fonts.load(f));
      const timeout = new Promise(r => setTimeout(r, 3000));
      await Promise.race([Promise.all(fonts), timeout]);

      try {
        laura = await loadImage(LAURA_SRC, true);
      } catch {
        try { laura = await loadImage(LAURA_SRC, false); } catch { laura = null; }
      }

      if (laura && isTainting(laura)) {
        ui.download.disabled = true;
        ui.download.title = 'La imagen de Laura no permite exportar el video desde el navegador (CORS).';
      }

      requestAnimationFrame(frame);
    }

    init();
  </script>
</body>
</html>
