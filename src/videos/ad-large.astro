<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>metroKUBIKO Planea — Motion Ad</title>
  
  <!-- Tipografías de marca -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

  <style>
    /* ----------------------------------------------------
       ESTILOS BASE & TEMA CLARO CORPORATIVO
    ---------------------------------------------------- */
    :root {
      --bg: #F8F9FA;
      --surface: #FFFFFF;
      --border: #E5E7EB;
      --border-focus: #D1D5DB;
      --text-main: #111827;
      --text-muted: #6B7280;
      --text-sub: #4B5563;
      --orange: #FF6A1A;
      --orange-light: rgba(255, 106, 26, 0.08);
      --orange-border: rgba(255, 106, 26, 0.35);
      --green: #10B981;
      --green-light: rgba(16, 185, 129, 0.1);
      --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.04);
      --shadow-md: 0 12px 30px rgba(0, 0, 0, 0.08);
      --shadow-lg: 0 20px 40px rgba(0, 0, 0, 0.12);
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #E5E7EB;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      font-family: 'Inter', sans-serif;
      color: var(--text-main);
      overflow: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Canvas de Video Ad (16:9 / 1280x720) */
    .ad-canvas {
      width: 1280px;
      height: 720px;
      background: var(--bg);
      position: relative;
      overflow: hidden;
      border-radius: 16px;
      box-shadow: 0 25px 60px rgba(0,0,0,0.15);
      border: 1px solid #D1D5DB;
      display: flex;
      flex-direction: column;
    }

    /* Fondo milimétrico arquitectónico */
    .ad-canvas::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(0,0,0,0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(0,0,0,0.03) 1px, transparent 1px);
      background-size: 32px 32px;
      pointer-events: none;
    }

    .mono { font-family: 'IBM Plex Mono', monospace; }
    .heading { font-family: 'Space Grotesk', sans-serif; }

    /* Barra Superior Persistente */
    .top-bar {
      position: absolute;
      top: 28px;
      left: 48px;
      right: 48px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      z-index: 100;
    }
    .top-logo {
      height: 28px;
      width: auto;
    }
    .top-badge {
      background: var(--orange-light);
      border: 1px solid var(--orange-border);
      color: var(--orange);
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 13px;
      font-weight: 600;
    }

    /* Títulos Dinámicos Superiores */
    .scene-caption-area {
      position: absolute;
      top: 86px;
      left: 48px;
      right: 48px;
      height: 70px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      text-align: center;
      z-index: 90;
      pointer-events: none;
    }
    .scene-caption {
      font-size: 26px;
      font-weight: 700;
      color: var(--text-main);
      transition: all 0.5s ease;
      opacity: 0;
      transform: translateY(-10px);
      position: absolute;
      max-width: 900px;
    }
    .scene-caption.active {
      opacity: 1;
      transform: translateY(0);
    }

    /* Escenario central */
    .stage {
      position: absolute;
      inset: 150px 48px 48px 48px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* ----------------------------------------------------
       SLIDE 1: HOOK
    ---------------------------------------------------- */
    .hook-container {
      text-align: center;
      max-width: 840px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      opacity: 0;
      transform: scale(0.96);
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      position: absolute;
    }
    .hook-container.active {
      opacity: 1;
      transform: scale(1);
    }
    .hook-title {
      font-size: 54px;
      line-height: 1.15;
      color: var(--text-main);
      font-weight: 700;
      letter-spacing: -0.02em;
    }
    .hook-title span { color: var(--orange); }
    .hook-sub {
      font-size: 21px;
      color: var(--text-muted);
      line-height: 1.5;
      max-width: 680px;
    }

    /* ----------------------------------------------------
       SLIDE 2: ENTRADA (IFC + CONTEXTO)
    ---------------------------------------------------- */
    .input-stage {
      display: flex;
      gap: 36px;
      align-items: center;
      justify-content: center;
      position: absolute;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .input-stage.active {
      opacity: 1;
      transform: translateY(0);
    }
    .input-stage.fly-to-laura {
      transform: scale(0.15) !important;
      opacity: 0 !important;
      transition: all 0.9s cubic-bezier(0.5, 0, 0.2, 1) !important;
    }

    .bim-card {
      width: 370px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 22px;
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }
    .file-badge {
      display: flex;
      align-items: center;
      gap: 10px;
      background: #F3F4F6;
      border: 1px solid #E5E7EB;
      padding: 8px 12px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
    }
    .ifc-preview-box {
      height: 180px;
      background: #F9FAFB;
      border-radius: 12px;
      border: 1px solid #E5E7EB;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
    }

    .prompt-card {
      width: 440px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 18px;
      padding: 24px;
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
      gap: 14px;
    }
    .prompt-header {
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }
    .prompt-field {
      background: #F9FAFB;
      border: 1px solid var(--border-focus);
      border-radius: 10px;
      padding: 18px;
      font-size: 16px;
      line-height: 1.5;
      min-height: 108px;
      color: var(--text-main);
      position: relative;
    }
    .cursor-blink {
      display: inline-block;
      width: 2px;
      height: 18px;
      background: var(--orange);
      vertical-align: middle;
      animation: blink 0.8s infinite;
      margin-left: 2px;
    }
    @keyframes blink { 0%, 50% { opacity: 1; } 51%, 100% { opacity: 0; } }

    /* ----------------------------------------------------
       SLIDE 3: LAURA IA + CENTRADO MATEMÁTICO DEL HALO
    ---------------------------------------------------- */
    .laura-agent-node {
      position: absolute;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      z-index: 50;
      transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      opacity: 0;
      transform: scale(0.85);
    }
    .laura-agent-node.center {
      opacity: 1;
      transform: scale(1) translate(0, 0);
    }
    .laura-agent-node.dock-left {
      opacity: 1;
      transform: scale(0.9) translate(-390px, 0);
    }

    /* Contenedor relativo exacto para avatar + halo */
    .laura-avatar-center-anchor {
      position: relative;
      width: 140px;
      height: 140px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .laura-avatar-wrapper {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      background: var(--surface);
      padding: 6px;
      box-shadow: 0 0 0 4px var(--orange-light), var(--shadow-lg);
      position: relative;
      z-index: 2;
    }
    .laura-avatar-img {
      width: 100%;
      height: 100%;
      border-radius: 50%;
      object-fit: cover;
    }
    .laura-status-dot {
      position: absolute;
      bottom: 8px;
      right: 8px;
      width: 20px;
      height: 20px;
      background: var(--green);
      border: 3px solid var(--surface);
      border-radius: 50%;
      z-index: 3;
    }

    /* Halo concéntrico con centrado absoluto exacto */
    .processing-halo {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 210px;
      height: 210px;
      border-radius: 50%;
      border: 2px dashed rgba(255, 106, 26, 0.5);
      pointer-events: none;
      opacity: 0;
      z-index: 1;
      transform: translate(-50%, -50%) rotate(0deg);
      transition: opacity 0.5s ease;
    }
    .processing-halo.active {
      opacity: 1;
      animation: rotateHalo 12s linear infinite;
    }
    @keyframes rotateHalo {
      from { transform: translate(-50%, -50%) rotate(0deg); }
      to { transform: translate(-50%, -50%) rotate(360deg); }
    }

    .laura-name-tag {
      margin-top: 14px;
      font-size: 20px;
      font-weight: 700;
      color: var(--text-main);
    }
    .laura-role-tag {
      font-size: 13px;
      color: var(--orange);
      font-weight: 600;
      margin-top: 2px;
    }

    /* Chips secuenciales */
    .pipeline-chips {
      position: absolute;
      display: flex;
      gap: 10px;
      bottom: -62px;
      opacity: 0;
      transition: all 0.5s ease;
    }
    .pipeline-chips.active {
      opacity: 1;
      bottom: -48px;
    }
    .p-chip {
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 6px 14px;
      border-radius: 99px;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
      box-shadow: var(--shadow-sm);
      opacity: 0.3;
      transform: translateY(6px);
      transition: all 0.35s ease;
    }
    .p-chip.lit {
      opacity: 1;
      color: var(--orange);
      border-color: var(--orange-border);
      background: var(--orange-light);
      transform: translateY(0);
    }

    /* ----------------------------------------------------
       SLIDE 4 & 5: RESULTADOS & EDICIÓN
    ---------------------------------------------------- */
    .results-wrapper {
      position: absolute;
      display: flex;
      gap: 24px;
      align-items: stretch;
      opacity: 0;
      transform: translateX(60px);
      transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
      left: 360px;
    }
    .results-wrapper.active {
      opacity: 1;
      transform: translateX(0);
    }

    .output-card {
      width: 380px;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 22px;
      box-shadow: var(--shadow-md);
      display: flex;
      flex-direction: column;
    }
    .output-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--border);
      margin-bottom: 14px;
    }
    .output-title {
      font-size: 16px;
      font-weight: 700;
    }
    .output-tag {
      font-size: 11px;
      padding: 3px 8px;
      border-radius: 6px;
      font-weight: 600;
    }
    .tag-orange { background: var(--orange-light); color: var(--orange); }
    .tag-green { background: var(--green-light); color: var(--green); }

    .table-mini { display: flex; flex-direction: column; gap: 11px; }
    .t-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13.5px;
      padding: 4px 0;
      color: var(--text-sub);
    }
    .t-row .price {
      font-weight: 600;
      color: var(--text-main);
      transition: all 0.4s ease;
    }
    .t-row.highlighted .price {
      color: var(--orange);
      transform: scale(1.12);
    }
    .t-total {
      margin-top: 14px;
      padding-top: 14px;
      border-top: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .t-total-val {
      font-size: 19px;
      font-weight: 700;
      color: var(--text-main);
      transition: all 0.4s ease;
    }
    .t-total-val.updated {
      color: var(--orange);
      transform: scale(1.08);
    }

    .gantt-mini { display: flex; flex-direction: column; gap: 13px; }
    .g-item { display: flex; flex-direction: column; gap: 4px; }
    .g-meta {
      display: flex;
      justify-content: space-between;
      font-size: 12.5px;
      color: var(--text-sub);
    }
    .g-bar-bg {
      height: 10px;
      background: #F3F4F6;
      border-radius: 6px;
      overflow: hidden;
      position: relative;
    }
    .g-bar-fill {
      position: absolute;
      top: 0;
      bottom: 0;
      background: var(--green);
      border-radius: 6px;
      transition: width 0.6s ease;
    }

    /* Globo de diálogo de Edición */
    .edit-speech-box {
      position: absolute;
      top: 215px;
      left: 165px;
      width: 300px;
      background: var(--surface);
      border: 1px solid var(--orange-border);
      box-shadow: var(--shadow-lg);
      border-radius: 12px;
      padding: 16px;
      font-size: 14px;
      line-height: 1.45;
      color: var(--text-main);
      z-index: 80;
      opacity: 0;
      transform: scale(0.9) translateY(10px);
      transition: all 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .edit-speech-box.active {
      opacity: 1;
      transform: scale(1) translateY(0);
    }

    /* ----------------------------------------------------
       SLIDE 6: CIERRE BRANDING
    ---------------------------------------------------- */
    .closing-container {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 20px;
      position: absolute;
      opacity: 0;
      transform: scale(0.92);
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 120;
    }
    .closing-container.active {
      opacity: 1;
      transform: scale(1);
    }
    .closing-badge {
      background: #FFFFFF;
      border: 1px solid var(--border);
      padding: 8px 18px;
      border-radius: 99px;
      font-size: 14px;
      font-weight: 600;
      color: var(--text-sub);
      box-shadow: var(--shadow-sm);
    }
    .closing-logo {
      height: 52px;
      width: auto;
    }
    .closing-punchline {
      font-size: 40px;
      font-weight: 700;
      color: var(--text-main);
      letter-spacing: -0.02em;
    }
    .closing-punchline span { color: var(--orange); }

    /* ----------------------------------------------------
       SLIDE 7: FINAL WAITLIST CTA
    ---------------------------------------------------- */
    .waitlist-container {
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 22px;
      position: absolute;
      opacity: 0;
      transform: translateY(20px);
      transition: all 0.7s cubic-bezier(0.16, 1, 0.3, 1);
      z-index: 130;
      max-width: 860px;
    }
    .waitlist-container.active {
      opacity: 1;
      transform: translateY(0);
    }
    .waitlist-lead {
      font-size: 42px;
      font-weight: 700;
      line-height: 1.2;
      color: var(--text-main);
      letter-spacing: -0.02em;
    }
    .waitlist-lead span { color: var(--orange); }
    .waitlist-sub {
      font-size: 22px;
      color: var(--text-sub);
      font-weight: 500;
    }
    .btn-cta-waitlist {
      margin-top: 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: var(--orange);
      color: #FFFFFF;
      font-size: 17px;
      font-weight: 700;
      padding: 18px 40px;
      border-radius: 999px;
      text-decoration: none;
      box-shadow: 0 10px 25px rgba(255, 106, 26, 0.35);
      border: none;
      letter-spacing: 0.04em;
      transform: scale(1);
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .btn-cta-waitlist:hover {
      transform: scale(1.03);
      box-shadow: 0 14px 32px rgba(255, 106, 26, 0.45);
    }
  </style>
</head>
<body>

  <div class="ad-canvas">

    <!-- BARRA SUPERIOR -->
    <header class="top-bar">
      <img 
        src="https://firebasestorage.googleapis.com/v0/b/copres-firebase.appspot.com/o/CoPres%2Flogo-planea%20-%20invertido.png?alt=media&token=1284529d-0d43-44c9-b851-c7aa91fccdfd" 
        alt="metroKUBIKO Planea" 
        class="top-logo"
        style="filter: invert(1) hue-rotate(180deg);"
      >
      <div class="top-badge">IA + Modelo BIM</div>
    </header>

    <!-- TEXTOS DINÁMICOS SUPERIORES -->
    <div class="scene-caption-area">
      <h2 class="scene-caption heading" id="caption-input">
        Sube tu modelo IFC y agrega contexto para obtener mejores resultados.
      </h2>
      <h2 class="scene-caption heading" id="caption-processing">
        Laura analiza tu modelo y genera el presupuesto y cronograma de obra.
      </h2>
      <h2 class="scene-caption heading" id="caption-editing">
        Edita con Laura, manualmente o actualiza las cantidades desde tu modelo IFC.
      </h2>
    </div>

    <!-- ESCENARIO CENTRAL -->
    <main class="stage">

      <!-- 1. HOOK -->
      <section class="hook-container" id="hook-view">
        <h1 class="hook-title heading">
          ¿Tienes el <span>modelo BIM</span> de tu proyecto?
        </h1>
        <p class="hook-sub">
          Genera tu presupuesto y cronograma de obra con IA usando <strong>metroKUBIKO Planea</strong>.
        </p>
      </section>

      <!-- 2. ENTRADA -->
      <section class="input-stage" id="input-view">
        <div class="bim-card">
          <div class="file-badge mono">
            <span>📦</span>
            <span>torre_residencial.ifc</span>
            <span style="margin-left:auto;color:var(--text-muted);font-weight:400">18.4 MB</span>
          </div>
          <div class="ifc-preview-box">
            <svg width="150" height="130" viewBox="0 0 160 140" fill="none">
              <polygon points="80,20 140,50 80,80 20,50" fill="#FFFFFF" stroke="#D1D5DB" stroke-width="1.5"/>
              <polygon points="20,50 80,80 80,130 20,100" fill="#F3F4F6" stroke="#D1D5DB" stroke-width="1.5"/>
              <polygon points="80,80 140,50 140,100 80,130" fill="#E5E7EB" stroke="#D1D5DB" stroke-width="1.5"/>
              <line x1="40" y1="60" x2="40" y2="110" stroke="#FF6A1A" stroke-width="2"/>
              <line x1="60" y1="70" x2="60" y2="120" stroke="#FF6A1A" stroke-width="2"/>
              <line x1="100" y1="70" x2="100" y2="120" stroke="#FF6A1A" stroke-width="2"/>
              <line x1="120" y1="60" x2="120" y2="110" stroke="#FF6A1A" stroke-width="2"/>
            </svg>
          </div>
        </div>

        <div class="prompt-card">
          <div class="prompt-header mono">Contexto del proyecto</div>
          <div class="prompt-field" id="prompt-typing">
            <span id="prompt-text"></span><span class="cursor-blink"></span>
          </div>
        </div>
      </section>

      <!-- 3. LAURA IA -->
      <section class="laura-agent-node" id="laura-view">
        <div class="laura-avatar-center-anchor">
          <!-- Halo perfectamente concéntrico -->
          <div class="processing-halo" id="halo"></div>

          <div class="laura-avatar-wrapper">
            <img 
              src="https://firebasestorage.googleapis.com/v0/b/copres-firebase.appspot.com/o/CoPres%2Flaura%2Fprofile-2.png?alt=media&token=af875745-5d70-4d56-9c78-cddd27880410" 
              alt="Laura IA" 
              class="laura-avatar-img"
            >
            <div class="laura-status-dot"></div>
          </div>
        </div>

        <div class="laura-name-tag heading">Laura</div>
        <div class="laura-role-tag mono">Agente IA de Obra</div>

        <div class="pipeline-chips mono" id="chips-bar">
          <div class="p-chip" id="c-1">Muros</div>
          <div class="p-chip" id="c-2">Columnas</div>
          <div class="p-chip" id="c-3">Puertas</div>
          <div class="p-chip" id="c-4">Cantidades</div>
          <div class="p-chip" id="c-5">Actividades</div>
          <div class="p-chip" id="c-6">APUs</div>
        </div>
      </section>

      <!-- GLOBO EDICIÓN -->
      <div class="edit-speech-box mono" id="speech-box">
        <span style="color:var(--orange)">✦ Laura:</span> “Cambia el precio del concreto y actualiza el presupuesto.”
      </div>

      <!-- 4 & 5. RESULTADOS (PRESUPUESTO Y CRONOGRAMA) -->
      <section class="results-wrapper" id="results-view">
        <div class="output-card">
          <div class="output-header">
            <span class="output-title heading">Presupuesto</span>
            <span class="output-tag tag-orange mono">COP / USD</span>
          </div>
          <div class="table-mini">
            <div class="t-row">
              <span>01 Cimentación y Zapatas</span>
              <span class="price mono">$14,500</span>
            </div>
            <div class="t-row" id="row-concreto">
              <span>02 Concreto Estructural</span>
              <span class="price mono" id="price-concreto">$38,200</span>
            </div>
            <div class="t-row">
              <span>03 Mampostería y Muros</span>
              <span class="price mono">$19,400</span>
            </div>
            <div class="t-row">
              <span>04 Acabados y Pisos</span>
              <span class="price mono">$27,300</span>
            </div>
          </div>
          <div class="t-total">
            <span class="mono" style="font-size:12px;color:var(--text-muted)">TOTAL ESTIMADO</span>
            <span class="t-total-val mono" id="total-val">$99,400</span>
          </div>
        </div>

        <div class="output-card">
          <div class="output-header">
            <span class="output-title heading">Cronograma</span>
            <span class="output-tag tag-green mono">CPM Activo</span>
          </div>
          <div class="gantt-mini">
            <div class="g-item">
              <div class="g-meta">
                <span>01 Preliminares</span>
                <span class="mono">12 días</span>
              </div>
              <div class="g-bar-bg"><div class="g-bar-fill" style="left:0;width:35%"></div></div>
            </div>
            <div class="g-item">
              <div class="g-meta">
                <span>02 Estructura en Concreto</span>
                <span class="mono">28 días</span>
              </div>
              <div class="g-bar-bg"><div class="g-bar-fill" style="left:30%;width:48%"></div></div>
            </div>
            <div class="g-item">
              <div class="g-meta">
                <span>03 Albañilería</span>
                <span class="mono">20 días</span>
              </div>
              <div class="g-bar-bg"><div class="g-bar-fill" style="left:60%;width:35%"></div></div>
            </div>
          </div>
          <div class="t-total">
            <span class="mono" style="font-size:12px;color:var(--text-muted)">PLAZO TOTAL</span>
            <span class="mono" style="font-size:16px;font-weight:700;color:var(--green)">60 DÍAS</span>
          </div>
        </div>
      </section>

      <!-- 6. CIERRE MARCA -->
      <section class="closing-container" id="closing-view">
        <div class="closing-badge mono">Ecosistema metroKUBIKO Suite</div>
        <img 
          src="https://firebasestorage.googleapis.com/v0/b/copres-firebase.appspot.com/o/CoPres%2Flogo-planea%20-%20invertido.png?alt=media&token=1284529d-0d43-44c9-b851-c7aa91fccdfd" 
          alt="metroKUBIKO Planea" 
          class="closing-logo"
          style="filter: invert(1) hue-rotate(180deg);"
        >
        <h2 class="closing-punchline heading">
          Del modelo BIM al <span>presupuesto y cronograma.</span>
        </h2>
      </section>

      <!-- 7. SLIDE FINAL: WAITLIST CTA -->
      <section class="waitlist-container" id="waitlist-view">
        <h2 class="waitlist-lead heading">
          Lleva tu modelo BIM del IFC al <span>presupuesto y cronograma.</span>
        </h2>
        <p class="waitlist-sub">
          Únete a la lista de espera de metroKUBIKO Planea.
        </p>
        <button class="btn-cta-waitlist heading" type="button">
          [ UNIRME A LA LISTA DE ESPERA ]
        </button>
      </section>

    </main>

  </div>

  <!-- CONTROLADOR DE TIEMPOS AMPLIADOS (~32 SEGUNDOS) -->
  <script>
    const MotionEngine = {
      timeouts: [],

      // Elementos
      hookView: document.getElementById('hook-view'),
      inputView: document.getElementById('input-view'),
      lauraView: document.getElementById('laura-view'),
      resultsView: document.getElementById('results-view'),
      closingView: document.getElementById('closing-view'),
      waitlistView: document.getElementById('waitlist-view'),
      speechBox: document.getElementById('speech-box'),
      halo: document.getElementById('halo'),
      chipsBar: document.getElementById('chips-bar'),
      promptTextEl: document.getElementById('prompt-text'),

      // Captions
      capInput: document.getElementById('caption-input'),
      capProcessing: document.getElementById('caption-processing'),
      capEditing: document.getElementById('caption-editing'),

      // Presupuesto
      rowConcreto: document.getElementById('row-concreto'),
      priceConcreto: document.getElementById('price-concreto'),
      totalVal: document.getElementById('total-val'),

      chips: [
        document.getElementById('c-1'),
        document.getElementById('c-2'),
        document.getElementById('c-3'),
        document.getElementById('c-4'),
        document.getElementById('c-5'),
        document.getElementById('c-6')
      ],

      schedule(fn, delay) {
        const id = setTimeout(fn, delay);
        this.timeouts.push(id);
      },

      clearAll() {
        this.timeouts.forEach(clearTimeout);
        this.timeouts = [];
      },

      typeText(text, targetEl, speed = 40, callback) {
        let i = 0;
        targetEl.textContent = "";
        const interval = setInterval(() => {
          targetEl.textContent += text.charAt(i);
          i++;
          if (i >= text.length) {
            clearInterval(interval);
            if (callback) callback();
          }
        }, speed);
      },

      reset() {
        this.clearAll();

        this.hookView.classList.remove('active');
        this.inputView.classList.remove('active', 'fly-to-laura');
        this.lauraView.classList.remove('center', 'dock-left');
        this.resultsView.classList.remove('active');
        this.closingView.classList.remove('active');
        this.waitlistView.classList.remove('active');
        this.speechBox.classList.remove('active');
        this.halo.classList.remove('active');
        this.chipsBar.classList.remove('active');

        this.capInput.classList.remove('active');
        this.capProcessing.classList.remove('active');
        this.capEditing.classList.remove('active');

        this.chips.forEach(c => c.classList.remove('lit'));
        this.promptTextEl.textContent = "";

        this.priceConcreto.textContent = "$38,200";
        this.totalVal.textContent = "$99,400";
        this.rowConcreto.classList.remove('highlighted');
        this.totalVal.classList.remove('updated');
      },

      play() {
        this.reset();

        // ----------------------------------------------------
        // T = 0.0s : SLIDE 1 (HOOK - 4.5s de lectura cómoda)
        // ----------------------------------------------------
        this.schedule(() => {
          this.hookView.classList.add('active');
        }, 200);

        // ----------------------------------------------------
        // T = 4.6s : SLIDE 2 (ENTRADA + TIPEO CALMADO)
        // ----------------------------------------------------
        this.schedule(() => {
          this.hookView.classList.remove('active');
          this.capInput.classList.add('active');
          this.inputView.classList.add('active');

          this.schedule(() => {
            this.typeText("Proyecto ubicado en Bogotá. Inicio: 1 de enero de 2027.", this.promptTextEl, 40);
          }, 450);
        }, 4600);

        // ----------------------------------------------------
        // T = 10.2s : SLIDE 3 (PROCESAMIENTO CON LAURA)
        // ----------------------------------------------------
        this.schedule(() => {
          this.capInput.classList.remove('active');
          this.capProcessing.classList.add('active');

          this.lauraView.classList.add('center');
          this.inputView.classList.add('fly-to-laura');

          this.halo.classList.add('active');
          this.chipsBar.classList.add('active');

          // Secuencia pausada de elementos
          this.schedule(() => this.chips[0].classList.add('lit'), 500);
          this.schedule(() => this.chips[1].classList.add('lit'), 900);
          this.schedule(() => this.chips[2].classList.add('lit'), 1300);
          this.schedule(() => this.chips[3].classList.add('lit'), 1700);
          this.schedule(() => this.chips[4].classList.add('lit'), 2100);
          this.schedule(() => this.chips[5].classList.add('lit'), 2500);
        }, 10200);

        // ----------------------------------------------------
        // T = 15.2s : SLIDE 4 (RESULTADO: PRESUPUESTO + CRONOGRAMA)
        // ----------------------------------------------------
        this.schedule(() => {
          this.halo.classList.remove('active');
          this.chipsBar.classList.remove('active');

          this.lauraView.classList.remove('center');
          this.lauraView.classList.add('dock-left');
          this.resultsView.classList.add('active');
        }, 15200);

        // ----------------------------------------------------
        // T = 19.5s : SLIDE 5 (EDICIÓN Y ACTUALIZACIÓN)
        // ----------------------------------------------------
        this.schedule(() => {
          this.capProcessing.classList.remove('active');
          this.capEditing.classList.add('active');
          this.speechBox.classList.add('active');

          this.schedule(() => {
            this.rowConcreto.classList.add('highlighted');
            this.priceConcreto.textContent = "$42,800";
            
            this.totalVal.classList.add('updated');
            this.totalVal.textContent = "$104,000";
          }, 1500);
        }, 19500);

        // ----------------------------------------------------
        // T = 24.5s : SLIDE 6 (CIERRE MARCA METROKUBIKO)
        // ----------------------------------------------------
        this.schedule(() => {
          this.capEditing.classList.remove('active');
          this.speechBox.classList.remove('active');
          this.lauraView.classList.remove('dock-left');
          this.resultsView.classList.remove('active');

          this.closingView.classList.add('active');
        }, 24500);

        // ----------------------------------------------------
        // T = 28.0s : SLIDE 7 (CALL TO ACTION / LISTA DE ESPERA)
        // ----------------------------------------------------
        this.schedule(() => {
          this.closingView.classList.remove('active');
          this.waitlistView.classList.add('active');
        }, 28000);

        // ----------------------------------------------------
        // T = 33.5s : REINICIO SUAVE DEL BUCLE
        // ----------------------------------------------------
        this.schedule(() => {
          this.play();
        }, 33500);
      }
    };

    window.addEventListener('DOMContentLoaded', () => {
      MotionEngine.play();
    });
  </script>
</body>
</html>