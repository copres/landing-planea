              </div>
            </div>

            <!-- The 4 Connected Cards -->
            <div class="demo-grid">
              
              <!-- CARD 1: ENTRADA -->
              <div class="d-card" id="card-input">
                <div class="d-card-head">
                  <span class="d-card-title">01 Entrada</span>
                  <span class="d-card-tag" id="input-type-badge">IFC BIM</span>
                </div>
                <div class="d-card-body">
                  
                  <!-- TAB 1: BIM -->
                  <div id="view-bim" class="anim-fade show" style="display:flex;flex-direction:column;height:100%;gap:10px">
                    <div class="file-pill">
                      <span>📁</span>
                      <span>edificio_apts.ifc</span>
                      <span style="color:var(--stone-500);margin-left:auto">18.4 MB</span>
                    </div>

                    <!-- 3D Isometric Technical Apartment Building SVG -->
