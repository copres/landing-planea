            <option value="Ingeniero de Costos / Presupuestador">Ingeniero de Costos / Presupuestador</option>
            <option value="Residente de Obra">Residente de Obra</option>
            <option value="Arquitecto / Diseñador">Arquitecto / Diseñador</option>
            <option value="Contratista independiente">Contratista independiente</option>
            <option value="Gerente General / Socio">Gerente General / Socio</option>
            <option value="Estudiante / Académico">Estudiante / Académico</option>
            <option value="Otro">Otro</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="m-company">Empresa <span class="opt">(opcional)</span></label>
          <input type="text" id="m-company" name="company" placeholder="Constructora XYZ">
        </div>
        <div class="form-group">
          <label for="m-phone">Teléfono / WhatsApp <span class="opt">(opcional)</span></label>
          <input type="tel" id="m-phone" name="phone" placeholder="+57 300 123 4567">
