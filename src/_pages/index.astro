                        <polygon points="104,38 112,34 112,43 104,47" fill="#ff6a1a25" stroke="#ff6a1a" stroke-width="0.9" />

                        <polygon points="48,51 56,55 56,64 48,60" fill="#ff6a1a18" stroke="#ff6a1a" stroke-width="0.9" />
                        <polygon points="64,59 72,63 72,72 64,68" fill="#ff6a1a18" stroke="#ff6a1a" stroke-width="0.9" />
                        <polygon points="88,63 96,59 96,68 88,72" fill="#ff6a1a25" stroke="#ff6a1a" stroke-width="0.9" />
                        <polygon points="104,55 112,51 112,60 104,64" fill="#ff6a1a25" stroke="#ff6a1a" stroke-width="0.9" />

