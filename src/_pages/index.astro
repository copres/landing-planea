                      <svg viewBox="0 0 160 125" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <polygon points="80,50 146,84 80,118 14,84" fill="#181512" stroke="#3d3730" stroke-width="1.2" />
                        <polygon points="14,84 80,118 80,124 14,90" fill="#120f0e" stroke="#2e2924" stroke-width="1" />
