                        <polygon points="80,87 86,84 86,99 80,102" fill="#ff6a1a45" stroke="#ff6a1a" stroke-width="1.1" />
                        <polygon points="48,68 56,72 56,81 48,77" fill="#181412" stroke="#524a42" stroke-width="0.8" />
                        <polygon points="104,72 112,68 112,77 104,81" fill="#181412" stroke="#524a42" stroke-width="0.8" />

                        <line x1="40" y1="48" x2="80" y2="68" stroke="#3a342c" stroke-width="0.9" />
                        <line x1="80" y1="68" x2="120" y2="48" stroke="#453e35" stroke-width="0.9" />
                        <line x1="40" y1="65" x2="80" y2="85" stroke="#3a342c" stroke-width="0.9" />
                        <line x1="80" y1="85" x2="120" y2="65" stroke="#453e35" stroke-width="0.9" />
                      </svg>
                    </div>

                    <div class="tag-grid">
                      <div class="tag-chip">12 aptos · 4 pisos</div>
                      <div class="tag-chip">muros 640 m²</div>
                      <div class="tag-chip">losas 480 m²</div>
                      <div class="tag-chip">Geometría IFC</div>
                    </div>
                  </div>

                  <!-- TAB 2: PROMPT -->
                  <div id="view-prompt" class="anim-fade" style="display:none;flex-direction:column;height:100%;gap:10px">
