            <span class="bim-arrow mono">→</span>
            <span class="bim-out">cómputos, APUs estructurados y valor total</span>
          </div>
          <div class="bim-row">
            <span class="bim-file mono">metroKUBIKO</span>
            <span class="bim-arrow mono">→</span>
            <span class="bim-out">control de obra, almacén y mano de obra</span>
          </div>
        </div>
      </div>
    </div>
  </section>

