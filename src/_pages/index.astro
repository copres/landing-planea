                        <polygon points="80,14 120,-6 80,-26 40,-6" fill="#171412" stroke="#7c756b" stroke-width="1.2" transform="translate(0,30)" />

                        <!-- Windows Grid -->
                        <polygon points="48,34 56,38 56,47 48,43" fill="#ff6a1a18" stroke="#ff6a1a" stroke-width="0.9" />
