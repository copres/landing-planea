---
// metroKUBIKO Planea — Landing Page
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>metroKUBIKO Planea — Presupuesto y cronograma de obra con IA</title>
  <meta name="description" content="Planea genera el presupuesto y el cronograma de tu obra a partir de un modelo BIM, una descripción en lenguaje natural o de forma manual con precios de internet por IA y conexión a obra con metroKUBIKO.">
  <link rel="icon" href="/assets/favicon_m3.png" type="image/png">
  <link rel="apple-touch-icon" href="/assets/favicon_m3.png">

  <!-- Open Graph / SEO -->
  <meta property="og:site_name" content="metroKUBIKO Planea" />
  <meta property="og:title" content="metroKUBIKO Planea — Presupuesto y cronograma de obra con IA" />
  <meta property="og:description" content="Genera presupuesto y cronograma con IA, buscador web de precios en tiempo real, tus propias bases y conexión a control de obra en metroKUBIKO." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="metroKUBIKO Planea — Presupuesto y cronograma de obra con IA" />
  <meta name="twitter:description" content="Genera presupuesto y cronograma con IA, buscador web de precios en tiempo real, tus propias bases y conexión a control de obra en metroKUBIKO." />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Cloudflare Turnstile -->
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <style is:inline>
    :root{
      --stone-950:#0c0a09;
      --stone-925:#141210;
      --stone-900:#1c1917;
      --stone-850:#232019;
      --stone-800:#2b2723;
      --stone-700:#453f38;
      --stone-500:#7c756b;
      --stone-400:#a39a8d;
      --stone-200:#e6e1d8;
      --stone-50:#faf8f4;
      --accent:#ff6a1a;
      --accent-dim:#ff6a1a26;
      --accent-ink:#2a1206;
      --ok:#7cb88f;
      --line:#332e28;
      --radius:14px;
      --maxw:1180px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      background:var(--stone-950);
      color:var(--stone-200);
      font-family:'Inter',sans-serif;
      font-size:16px;
      line-height:1.6;
      -webkit-font-smoothing:antialiased;
    }
    h1,h2,h3{
      font-family:'Space Grotesk',sans-serif;
      color:var(--stone-50);
      margin:0;
      letter-spacing:-0.01em;
    }
    .mono{font-family:'IBM Plex Mono',monospace}
    a{color:inherit}
    img{max-width:100%;display:block}
    .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
    section{padding:96px 0}
    @media (max-width:760px){ section{padding:64px 0} }

    /* ---------- Nav ---------- */
    header.nav{
      position:sticky;top:0;z-index:50;
      background:rgba(12,10,9,0.85);
      backdrop-filter:blur(10px);
      border-bottom:1px solid var(--line);
    }
    .nav-inner{
      max-width:var(--maxw);margin:0 auto;padding:16px 24px;
      display:flex;align-items:center;justify-content:space-between;gap:24px;
      position:relative;
    }
    .brand{display:flex;align-items:center;gap:10px;text-decoration:none}
    .brand img{height:28px;width:auto}
    .brand-name{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:17px;color:var(--stone-50)}
    .brand-name span{color:var(--accent)}
    nav.links{display:flex;gap:28px;font-size:14.5px;color:var(--stone-400)}
    nav.links a{text-decoration:none;transition:color .15s ease}
    nav.links a:hover{color:var(--stone-50)}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:11px 22px;border-radius:999px;font-weight:600;font-size:14.5px;
      text-decoration:none;border:1px solid transparent;cursor:pointer;
      transition:transform .15s ease, background .15s ease, border-color .15s ease;
      font-family:'Inter',sans-serif;
    }
    .btn-primary{background:var(--accent);color:#1a0c02}
    .btn-primary:hover{transform:translateY(-1px);background:#ff7a30}
    .btn-ghost{background:transparent;color:var(--stone-50);border-color:var(--stone-700)}
    .btn-ghost:hover{border-color:var(--stone-400)}
    .menu-toggle{display:none;background:none;border:none;color:var(--stone-50);font-size:22px;cursor:pointer}
    @media (max-width:860px){
      nav.links{ display:none; }
      nav.links.open{
        display:flex;
        flex-direction:column;
        position:absolute;
        top:100%;
        left:0;
        right:0;
        background:var(--stone-925);
        border-bottom:1px solid var(--line);
        padding:20px 24px;
        gap:18px;
      }
      .menu-toggle{display:block}
    }

    /* ---------- Hero ---------- */
    .hero{padding:76px 0 40px;position:relative;overflow:hidden}
    .hero::before{
      content:"";position:absolute;inset:-20% -10% auto -10%;height:520px;
      background:radial-gradient(60% 60% at 50% 0%, var(--accent-dim), transparent 70%);
      pointer-events:none;
    }
    .eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:22px}
    .dot-live{width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px rgba(124,184,143,0.18)}
    .eyebrow{font-size:13.5px;color:var(--stone-400)}
    .hero h1{
      font-size:clamp(34px,5vw,58px);
      font-weight:600;
      line-height:1.08;
      max-width:16ch;
    }
    .hero .sub{
      margin-top:22px;max-width:58ch;color:var(--stone-400);font-size:18px;
    }
    .hero-ctas{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap}
    .hero-note{margin-top:16px;color:var(--stone-500);font-size:13.5px}

    /* ---------- Flow Selector & Interactive Demo ---------- */
    .flow{
      margin-top:64px;border:1px solid var(--line);border-radius:20px;
      background:linear-gradient(180deg, var(--stone-925), var(--stone-950));
      overflow:hidden;
      box-shadow:0 24px 48px -12px rgba(0,0,0,0.55);
    }
    .flow-tabs{
      display:flex;border-bottom:1px solid var(--line);
      overflow-x:auto;
      scrollbar-width:none;
    }
    .flow-tabs::-webkit-scrollbar{display:none}
    .flow-tab{
      flex:1;min-width:210px;text-align:left;background:none;border:none;cursor:pointer;
      padding:20px 22px;color:var(--stone-400);
      border-right:1px solid var(--line);
      font-family:'Inter',sans-serif;
      position:relative;
      transition:background .2s ease, color .2s ease;
    }
    .flow-tab:last-child{border-right:none}
    .flow-tab .k{
      font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--stone-500);
      display:block;margin-bottom:6px;transition:color .2s ease;
    }
    .flow-tab .t{color:var(--stone-50);font-weight:600;font-size:15.5px;display:block}
    .flow-tab.active{color:var(--stone-50);background:var(--stone-900)}
    .flow-tab.active::after{
      content:"";position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--accent);
    }
    .flow-tab.active .k{color:var(--accent)}

    .flow-body{padding:32px 28px 36px}
    .flow-desc{color:var(--stone-400);max-width:68ch;margin:0 0 24px;font-size:15px;line-height:1.6}

    /* DEMO BOARD */
    .demo-board{
      background:var(--stone-950);
      border:1px solid var(--line);
      border-radius:16px;
      padding:20px;
      position:relative;
    }
    .demo-header-bar{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding-bottom:16px;
      border-bottom:1px solid #28241f;
      margin-bottom:20px;
      gap:12px;
      flex-wrap:wrap;
    }
    .demo-bar-left{
      display:flex;
      align-items:center;
      gap:12px;
      flex-wrap:wrap;
    }
    .demo-badge{
      display:inline-flex;
      align-items:center;
      gap:8px;
      padding:5px 12px;
      background:var(--stone-900);
      border:1px solid var(--line);
      border-radius:999px;
      font-family:'IBM Plex Mono',monospace;
      font-size:12px;
      color:var(--stone-200);
    }
    .demo-dot{
      width:7px;
      height:7px;
      border-radius:50%;
      background:var(--accent);
      box-shadow:0 0 0 3px var(--accent-dim);
      transition:background .25s ease, box-shadow .25s ease;
    }
    .demo-dot.done{
      background:var(--ok);
      box-shadow:0 0 0 3px rgba(124,184,143,0.25);
    }
    .demo-dot.paused{
      background:var(--stone-500);
      box-shadow:0 0 0 3px rgba(124,117,107,0.2);
    }
    .demo-bar-right{
      display:flex;
      align-items:center;
      gap:14px;
    }
    .demo-timer{
      font-family:'IBM Plex Mono',monospace;
      font-size:12px;
      color:var(--stone-500);
    }
    .btn-playback{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:5px 12px;
      background:var(--stone-900);
      border:1px solid var(--stone-700);
      border-radius:999px;
      color:var(--stone-200);
      font-family:'IBM Plex Mono',monospace;
      font-size:11.5px;
      cursor:pointer;
      transition:all .15s ease;
    }
    .btn-playback:hover{
      background:var(--stone-850);
      border-color:var(--stone-400);
      color:var(--stone-50);
    }
    .btn-playback.highlight{
      border-color:var(--accent);
      color:var(--accent);
      background:#241206;
    }

    /* Grid of 4 Cards */
    .demo-grid{
      display:grid;
      grid-template-columns:1.15fr 0.95fr 1.05fr 1.05fr;
      gap:16px;
      align-items:stretch;
    }
    @media (max-width:1040px){
      .demo-grid{ grid-template-columns:1fr 1fr; gap:16px; }
    }
    @media (max-width:640px){
      .demo-grid{ grid-template-columns:1fr; gap:16px; }
    }

    /* Card Panels */
    .d-card{
      background:var(--stone-925);
      border:1px solid var(--line);
      border-radius:12px;
      overflow:hidden;
      display:flex;
      flex-direction:column;
      transition:border-color .2s ease, transform .2s ease;
    }
    .d-card:hover{
      border-color:var(--stone-700);
    }
    .d-card.core-card{
      background:linear-gradient(180deg, #22130a, #141210);
      border-color:#542f1a;
    }
    .d-card-head{
      background:var(--stone-900);
      border-bottom:1px solid var(--line);
      padding:10px 14px;
      display:flex;
      justify-content:space-between;
      align-items:center;
    }
    .core-card .d-card-head{
      background:#2b160c;
      border-bottom-color:#542f1a;
    }
    .d-card-title{
      font-family:'Space Grotesk',sans-serif;
      font-size:12px;
      font-weight:600;
      letter-spacing:0.04em;
      text-transform:uppercase;
      color:var(--stone-50);
    }
    .d-card-tag{
      font-family:'IBM Plex Mono',monospace;
      font-size:10.5px;
      color:var(--stone-500);
    }
    .d-card-body{
      padding:14px;
      display:flex;
      flex-direction:column;
      flex:1;
      gap:12px;
    }

    /* Elements inside cards */
    .file-pill{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:5px 9px;
      background:var(--stone-850);
      border:1px solid var(--line);
      border-radius:6px;
      font-family:'IBM Plex Mono',monospace;
      font-size:11.5px;
      color:var(--stone-50);
    }
    .tag-grid{
      display:grid;
      grid-template-columns:1fr 1fr;
      gap:6px;
      margin-top:auto;
    }
    .tag-chip{
      background:var(--stone-900);
      border:1px solid var(--line);
      border-radius:5px;
      padding:4px 8px;
      font-family:'IBM Plex Mono',monospace;
      font-size:10.5px;
      color:var(--stone-400);
      white-space:nowrap;
      overflow:hidden;
      text-overflow:ellipsis;
    }
    .tag-chip.accent{
      background:var(--accent-dim);
      border-color:rgba(255,106,26,0.35);
      color:var(--accent);
    }

    /* Isometric BIM graphic */
    .bim-graphic-wrap{
      height:120px;
      display:flex;
      align-items:center;
      justify-content:center;
      background:#0e0c0a;
      border:1px solid #26221d;
      border-radius:8px;
      padding:4px;
    }
    .bim-graphic-wrap svg{
      max-height:100%;
      width:auto;
    }

    /* Prompt text mockup */
    .prompt-box{
      background:var(--stone-950);
      border:1px solid var(--line);
      border-radius:8px;
      padding:10px 12px;
      font-size:11.5px;
      line-height:1.45;
      color:var(--stone-200);
      position:relative;
    }
    .prompt-cursor{
      display:inline-block;
      width:6px;
      height:13px;
      background:var(--accent);
      vertical-align:middle;
      margin-left:2px;
      animation:blink 1s steps(2,start) infinite;
    }
    @keyframes blink{ to{ visibility:hidden; } }

    /* Manual item rows */
    .manual-list{
      display:flex;
      flex-direction:column;
      gap:6px;
    }
    .manual-row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      background:var(--stone-950);
      border:1px solid #28241f;
      padding:6px 10px;
      border-radius:6px;
      font-size:11.5px;
    }
    .ai-suggest-row{
      background:#1d130c;
      border:1px dashed #663214;
      padding:7px 10px;
      border-radius:6px;
      font-size:11px;
      display:flex;
      flex-direction:column;
      gap:2px;
    }

    /* Laura AI Core Visual */
    .laura-core{
      background:linear-gradient(180deg, #180e07, #0e0a07);
      border:1px solid #452412;
      border-radius:10px;
      padding:12px;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      position:relative;
      gap:8px;
    }
    .laura-avatar-wrap{
      position:relative;
      width:64px;
      height:64px;
      border-radius:50%;
      padding:3px;
      background:radial-gradient(circle, var(--accent) 0%, #3a1a08 70%);
      box-shadow:0 0 16px -2px rgba(255,106,26,0.35);
    }
    .laura-avatar{
      width:100%;
      height:100%;
      border-radius:50%;
      object-fit:cover;
      display:block;
      background:#141210;
    }
    .laura-pulse-dot{
      position:absolute;
      bottom:2px;
      right:2px;
      width:12px;
      height:12px;
      border-radius:50%;
      background:var(--ok);
      border:2px solid #141210;
      box-shadow:0 0 0 2px rgba(124,184,143,0.3);
    }
    .laura-role{
      font-family:'Space Grotesk',sans-serif;
      font-size:12.5px;
      font-weight:600;
      color:var(--stone-50);
      line-height:1.2;
    }
    .laura-sub{
      font-family:'IBM Plex Mono',monospace;
      font-size:10.5px;
      color:var(--accent);
    }
    .custom-rules-chip{
      display:inline-flex;
      align-items:center;
      gap:6px;
      padding:3px 8px;
      background:#26150b;
      border:1px solid #663214;
      border-radius:4px;
      font-family:'IBM Plex Mono',monospace;
      font-size:10px;
      color:var(--stone-300);
      margin-top:2px;
    }

    .metric-list{
      display:flex;
      flex-direction:column;
      gap:8px;
      margin-top:auto;
    }
    .metric-item{
      display:flex;
      align-items:center;
      gap:8px;
      font-size:11.5px;
      font-family:'Inter',sans-serif;
      color:var(--stone-200);
    }
    .metric-item .chk{
      color:var(--ok);
      font-family:'IBM Plex Mono',monospace;
      font-weight:600;
    }

    /* Budget Table */
    .budget-table{
      display:flex;
      flex-direction:column;
      gap:7px;
    }
    .b-header{
      display:flex;
      justify-content:space-between;
      font-family:'IBM Plex Mono',monospace;
      font-size:10px;
      color:var(--stone-500);
      padding-bottom:3px;
      border-bottom:1px solid #28241f;
    }
    .b-row{
      display:flex;
      justify-content:space-between;
      align-items:center;
      font-size:12px;
      padding:4px 0;
    }
    .b-row span:last-child{
      font-family:'IBM Plex Mono',monospace;
      color:var(--stone-200);
      font-size:11.5px;
    }
    .b-total{
      margin-top:auto;
      display:flex;
      justify-content:space-between;
      align-items:center;
      background:#21140b;
      border:1px solid #663214;
      border-radius:6px;
      padding:8px 10px;
    }
    .b-total .lbl{
      font-family:'IBM Plex Mono',monospace;
      font-size:11px;
      font-weight:600;
      color:var(--accent);
    }
    .b-total .val{
      font-family:'Space Grotesk',sans-serif;
      font-size:15px;
      font-weight:700;
      color:var(--stone-50);
    }

    /* Gantt Schedule */
    .gantt-wrap{
      display:flex;
      flex-direction:column;
      gap:8px;
    }
    .gantt-header{
      display:grid;
      grid-template-columns:repeat(5, 1fr);
      font-family:'IBM Plex Mono',monospace;
      font-size:9.5px;
      color:var(--stone-500);
      text-align:center;
      padding-bottom:4px;
      border-bottom:1px solid #28241f;
    }
    .gantt-grid{
      position:relative;
      display:flex;
      flex-direction:column;
      gap:8px;
      padding:4px 0;
    }
    .gantt-track{
      height:16px;
      background:rgba(255,255,255,0.02);
      border-radius:4px;
      position:relative;
    }
    .g-bar{
      position:absolute;
      top:1px;
      bottom:1px;
      border-radius:3px;
      background:var(--accent);
      opacity:0.9;
      transform-origin:left center;
      transform:scaleX(0);
      transition:transform 0.45s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.3s ease;
    }
    .g-bar.active{
      transform:scaleX(1);
    }
    .gantt-footer{
      margin-top:auto;
      display:flex;
      justify-content:space-between;
      align-items:center;
      background:var(--stone-900);
      border:1px solid var(--line);
      border-radius:6px;
      padding:7px 10px;
      font-family:'IBM Plex Mono',monospace;
      font-size:11px;
    }

    /* FINAL READY BANNER */
    .demo-ready-banner{
      margin-top:16px;
      padding:12px 18px;
      background:linear-gradient(90deg, #1f120a, #141210);
      border:1px solid #663214;
      border-radius:10px;
      display:flex;
      justify-content:space-between;
      align-items:center;
      gap:16px;
      flex-wrap:wrap;
      opacity:0;
      transform:translateY(6px);
      transition:opacity .35s ease, transform .35s ease;
    }
    .demo-ready-banner.visible{
      opacity:1;
      transform:translateY(0);
    }
    .ready-left{
      display:flex;
      align-items:center;
      gap:10px;
      font-size:13px;
      color:var(--stone-50);
      font-weight:600;
    }
    .ready-check{
      width:18px;
      height:18px;
      border-radius:50%;
      background:var(--ok);
      color:#0c0a09;
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:11px;
      font-weight:700;
    }
    .ready-stats{
      display:flex;
      gap:16px;
      font-family:'IBM Plex Mono',monospace;
      font-size:12px;
    }
    .ready-stats .p{color:var(--accent);font-weight:600}
    .ready-stats .c{color:var(--ok);font-weight:600}

    /* Reusable fade transition */
    .anim-fade{
      opacity:0;
      transform:translateY(5px);
      transition:opacity .3s ease, transform .3s ease;
    }
    .anim-fade.show{
      opacity:1;
      transform:translateY(0);
    }

    @media (prefers-reduced-motion: reduce){
      .anim-fade{opacity:1 !important; transform:none !important; transition:none !important;}
      .g-bar{transform:scaleX(1) !important; transition:none !important;}
      .demo-ready-banner{opacity:1 !important; transform:none !important;}
    }

    /* ---------- Features ---------- */
    .section-head{max-width:62ch;margin-bottom:52px}
    .section-head h2{font-size:clamp(26px,3.4vw,36px);font-weight:600}
    .section-head p{color:var(--stone-400);margin-top:14px;font-size:16.5px}
    .feat-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--line);border:1px solid var(--line);border-radius:16px;overflow:hidden}
    @media (max-width:900px){.feat-grid{grid-template-columns:repeat(2,1fr)}}
    @media (max-width:600px){.feat-grid{grid-template-columns:1fr}}
    .feat{background:var(--stone-950);padding:30px 26px}
    .feat h3{font-size:17px;margin-bottom:10px}
    .feat p{color:var(--stone-400);font-size:14.5px;margin:0}
    .feat .idx{font-family:'IBM Plex Mono',monospace;color:var(--accent);font-size:12px;margin-bottom:14px;display:block}

    /* ---------- BIM split ---------- */
    .split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
    @media (max-width:860px){.split{grid-template-columns:1fr;gap:40px}}
    .bim-diagram{
      border:1px solid var(--line);border-radius:16px;background:var(--stone-925);padding:28px;
    }
    .bim-row{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--line)}
    .bim-row:last-child{border-bottom:none}
    .bim-file{
      font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--stone-50);
      background:var(--stone-850);border:1px solid var(--line);padding:6px 10px;border-radius:8px;white-space:nowrap;
    }
    .bim-arrow{color:var(--stone-500)}
    .bim-out{color:var(--stone-400);font-size:13.5px}
    .split h2{font-size:clamp(24px,3vw,32px);font-weight:600;max-width:14ch}
    .split p.lead{color:var(--stone-400);margin-top:16px;font-size:16.5px;max-width:48ch}
    .checklist{margin-top:24px;display:flex;flex-direction:column;gap:12px;padding:0}
    .checklist li{list-style:none;display:flex;gap:10px;color:var(--stone-200);font-size:15px}
    .checklist li::before{content:"→";color:var(--accent);font-family:'IBM Plex Mono',monospace}

    /* ---------- METROKUBIKO PLATFORM INTEGRATION SECTION (POST-BIM) ---------- */
    .integration-box{
      background:linear-gradient(180deg, #191410, #100e0c);
      border:1px solid #4a2f1c;
      border-radius:24px;
      padding:48px 40px;
      position:relative;
      overflow:hidden;
      box-shadow:0 30px 60px -15px rgba(0,0,0,0.6);
    }
    .integration-box::after{
      content:"";position:absolute;top:-40%;right:-10%;width:420px;height:420px;
      background:radial-gradient(circle, rgba(255,106,26,0.14), transparent 70%);
      pointer-events:none;
    }
    .int-header{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:24px;
      flex-wrap:wrap;
      margin-bottom:36px;
    }
    .int-title-area{max-width:640px}
    .int-badge{
      display:inline-flex;align-items:center;gap:8px;
      font-family:'IBM Plex Mono',monospace;font-size:12px;
      background:var(--accent-dim);color:var(--accent);border:1px solid rgba(255,106,26,0.35);
      padding:4px 12px;border-radius:999px;margin-bottom:14px;
    }
    .int-title-area h2{font-size:clamp(24px,3.2vw,34px);font-weight:600;line-height:1.2}
    .int-title-area p{color:var(--stone-400);font-size:16px;margin-top:12px}
    
    .int-modules-grid{
      display:grid;
      grid-template-columns:repeat(4, 1fr);
      gap:16px;
      margin-top:28px;
    }
    @media (max-width:960px){.int-modules-grid{grid-template-columns:repeat(2,1fr)}}
    @media (max-width:540px){.int-modules-grid{grid-template-columns:1fr}}

    .int-card{
      background:var(--stone-925);
      border:1px solid var(--line);
      border-radius:14px;
      padding:22px;
      display:flex;
      flex-direction:column;
      gap:12px;
      transition:transform .2s ease, border-color .2s ease;
    }
    .int-card:hover{
      transform:translateY(-2px);
      border-color:var(--stone-700);
    }
    .int-card .i-icon{
      width:40px;
      height:40px;
      border-radius:9px;
      background:#26150b;
      border:1px solid #5a2e16;
      color:var(--accent);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }
    .int-card .i-icon svg{
      width:18px;
      height:18px;
      fill:currentColor;
      display:block;
    }
    .int-card h4{
      font-family:'Space Grotesk',sans-serif;
      font-size:15px;
      color:var(--stone-50);
      margin:0;
    }
    .int-card p{
      color:var(--stone-400);
      font-size:13px;
      margin:0;
      line-height:1.5;
    }

    .int-bottom-bar{
      margin-top:32px;
      padding-top:24px;
      border-top:1px solid var(--line);
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:16px;
    }
    .int-points{
      display:flex;gap:24px;flex-wrap:wrap;
    }
    .int-point{
      display:flex;align-items:center;gap:8px;
      font-family:'IBM Plex Mono',monospace;
      font-size:12.5px;
      color:var(--stone-300);
    }
    .int-point span{color:var(--ok)}

    /* ---------- Pricing Plans ---------- */
    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    @media (max-width:900px){.plans{grid-template-columns:1fr;max-width:420px;margin:0 auto}}
    .plan{
      border:1px solid var(--line);border-radius:16px;padding:30px 26px;background:var(--stone-925);
      display:flex;flex-direction:column;
    }
    .plan.featured{
      border-color:var(--accent);background:linear-gradient(180deg, #1f1108, var(--stone-925));
      position:relative;
    }
    .plan-badge{
      position:absolute;top:-13px;left:26px;background:var(--accent);color:#1a0c02;
      font-size:11.5px;font-weight:700;padding:4px 10px;border-radius:999px;font-family:'IBM Plex Mono',monospace;
    }
    .plan h3{font-size:19px}
    .plan .price{margin-top:14px;display:flex;align-items:baseline;gap:6px}
    .plan .price .num{font-family:'Space Grotesk',sans-serif;font-size:38px;font-weight:600;color:var(--stone-50)}
    .plan .price .per{color:var(--stone-500);font-size:14px}
    .plan .desc{color:var(--stone-400);font-size:14px;margin-top:10px;min-height:42px}
    .plan .includes{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--stone-500);margin-top:18px;padding-top:16px;border-top:1px solid var(--line)}
    .plan ul{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:11px;flex:1}
    .plan li{display:flex;justify-content:space-between;gap:12px;font-size:13.5px;color:var(--stone-200)}
    .plan li .v{color:var(--stone-400);font-family:'IBM Plex Mono',monospace;font-size:12.5px;text-align:right}
    .plan .btn{margin-top:24px;width:100%}

    /* ---------- CTA / waitlist ---------- */
    .cta-section{
      border-top:1px solid var(--line);border-bottom:1px solid var(--line);
      background:radial-gradient(70% 100% at 50% 0%, #241206, var(--stone-950));
    }
    .cta-inner{text-align:center;max-width:640px;margin:0 auto}
    .cta-inner h2{font-size:clamp(26px,4vw,38px)}
    .cta-inner p{color:var(--stone-400);margin-top:14px;font-size:16.5px}
    .waitlist-form{
      margin-top:32px;display:flex;flex-direction:column;align-items:center;gap:16px;
    }
    .waitlist-input-group{
      display:flex;gap:10px;justify-content:center;flex-wrap:wrap;width:100%;
    }
    .waitlist-form input[type=email]{
      background:var(--stone-900);border:1px solid var(--stone-700);color:var(--stone-50);
      padding:13px 16px;border-radius:999px;font-size:14.5px;min-width:280px;font-family:'Inter',sans-serif;
      transition:border-color .15s ease;
    }
    .waitlist-form input[type=email]:focus{outline:2px solid var(--accent);outline-offset:2px}
    .hp-field{
      position:absolute !important;
      left:-9999px !important;
      top:-9999px !important;
      opacity:0 !important;
      pointer-events:none !important;
      height:0 !important;
      width:0 !important;
      overflow:hidden !important;
    }
    .cf-turnstile-wrap{
      /* display: none !important; */
      display:flex;justify-content:center;min-height:50px;width:100%;margin-top:4px;
    }
    .btn.loading{opacity:0.75;cursor:not-allowed;pointer-events:none}
    .btn-loader{display:none;align-items:center;gap:8px}
    .waitlist-note{margin-top:14px;color:var(--stone-500);font-size:13px}
    .waitlist-success{display:none;margin-top:28px;color:var(--ok);font-family:'IBM Plex Mono',monospace;font-size:14px}
    .waitlist-error{display:none;margin-top:18px;color:#ff6b6b;font-family:'IBM Plex Mono',monospace;font-size:13.5px}

    /* ---------- Footer ---------- */
    footer{padding:56px 0 40px}
    .foot-top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap}
    .foot-brand{max-width:360px}
    .foot-brand img{height:24px;margin-bottom:16px}
    .foot-brand p{color:var(--stone-500);font-size:14px}
    .foot-cols{display:flex;gap:56px;flex-wrap:wrap}
    .foot-col h4{font-family:'Space Grotesk',sans-serif;color:var(--stone-50);font-size:13.5px;font-weight:600;margin-bottom:14px}
    .foot-col a{display:block;color:var(--stone-500);font-size:13.5px;text-decoration:none;margin-bottom:10px}
    .foot-col a:hover{color:var(--stone-200)}
    .foot-bottom{margin-top:48px;padding-top:24px;border-top:1px solid var(--line);display:flex;justify-content:space-between;color:var(--stone-500);font-size:13px;flex-wrap:wrap;gap:10px}
  </style>
</head>
