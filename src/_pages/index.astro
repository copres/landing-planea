<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>metroKUBIKO Planea — Presupuesto y cronograma de obra con IA</title>
  <meta name="description" content="Planea genera el presupuesto y el cronograma de tu obra a partir de un modelo BIM, una descripción en lenguaje natural o de forma manual con precios de internet por IA y conexión a obra con metroKUBIKO.">
  
  <!-- Favicon metroKUBIKO -->
  <link rel="icon" href="https://www.metrokubiko.com/assets/favicon_m3.png" type="image/png">
  <link rel="apple-touch-icon" href="https://www.metrokubiko.com/assets/favicon_m3.png">

  <!-- Open Graph / SEO -->
  <meta property="og:site_name" content="metroKUBIKO Planea" />
  <meta property="og:title" content="metroKUBIKO Planea — Presupuesto y cronograma de obra con IA" />
  <meta property="og:description" content="Genera presupuesto y cronograma con IA, buscador web de precios en tiempo real, tus propias bases y conexión a control de obra en metroKUBIKO." />
  <meta property="og:type" content="website" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="metroKUBIKO Planea — Presupuesto y cronograma de obra con IA" />
  <meta name="twitter:description" content="Genera presupuesto y cronograma con IA, buscador web de precios en tiempo real, tus propias bases y conexión a control de obra en metroKUBIKO." />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

  <style is:inline>
    :root{
      --stone-950:#faf9f6;
      --stone-925:#ffffff;
      --stone-900:#f4efe6;
      --stone-850:#eae4d8;
      --stone-800:#ded6c8;
      --stone-700:#c5bcae;
      --stone-500:#78716c;
      --stone-400:#57534e;
      --stone-200:#292524;
      --stone-50:#141210;
      --accent:#ea580c;
      --accent-dim:rgba(234,88,12,0.1);
      --accent-ink:#7c2d12;
      --ok:#16a34a;
      --line:#e7e1d7;
      --radius:14px;
      --maxw:1180px;
    }
    *{box-sizing:border-box}
    html{scroll-behavior:smooth}
    body{
      margin:0;
      background:var(--stone-950);
      color:var(--stone-200);
      font-family:'Inter',sans-serif;
      font-size:16px;
      line-height:1.6;
      -webkit-font-smoothing:antialiased;
    }
    h1,h2,h3,h4{
      font-family:'Space Grotesk',sans-serif;
      color:var(--stone-50);
      margin:0;
      letter-spacing:-0.01em;
    }
    .mono{font-family:'IBM Plex Mono',monospace}
    a{color:inherit}
    img{max-width:100%;display:block}
    .wrap{max-width:var(--maxw);margin:0 auto;padding:0 24px}
    section{padding:96px 0}
    @media (max-width:760px){ section{padding:64px 0} }

    /* ---------- Nav ---------- */
    header.nav{
      position:sticky;top:0;z-index:50;
      background:rgba(250,249,246,0.88);
      backdrop-filter:blur(10px);
      border-bottom:1px solid var(--line);
    }
    .nav-inner{
      max-width:var(--maxw);margin:0 auto;padding:16px 24px;
      display:flex;align-items:center;justify-content:space-between;gap:24px;
      position:relative;
    }
    .brand{display:flex;align-items:center;gap:10px;text-decoration:none}
    .brand img{height:28px;width:auto;filter:invert(1) hue-rotate(180deg)}
    .brand-name{font-family:'Space Grotesk',sans-serif;font-weight:600;font-size:17px;color:var(--stone-50)}
    .brand-name span{color:var(--accent)}
    nav.links{display:flex;gap:28px;font-size:14.5px;color:var(--stone-400)}
    nav.links a{text-decoration:none;transition:color .15s ease}
    nav.links a:hover{color:var(--stone-50)}
    .btn{
      display:inline-flex;align-items:center;justify-content:center;gap:8px;
      padding:11px 22px;border-radius:999px;font-weight:600;font-size:14.5px;
      text-decoration:none;border:1px solid transparent;cursor:pointer;
      transition:transform .15s ease, background .15s ease, border-color .15s ease, box-shadow .15s ease;
      font-family:'Inter',sans-serif;
    }
    .btn-primary{background:var(--accent);color:#ffffff;box-shadow:0 2px 8px rgba(234,88,12,0.22)}
    .btn-primary:hover{transform:translateY(-1px);background:#c2410c;box-shadow:0 4px 14px rgba(234,88,12,0.32)}
    .btn-ghost{background:transparent;color:var(--stone-50);border-color:var(--stone-700)}
    .btn-ghost:hover{border-color:var(--stone-400);background:rgba(0,0,0,0.03)}
    .menu-toggle{display:none;background:none;border:none;color:var(--stone-50);font-size:22px;cursor:pointer}
    @media (max-width:860px){
      nav.links{ display:none; }
      nav.links.open{
        display:flex;
        flex-direction:column;
        position:absolute;
        top:100%;
        left:0;
        right:0;
        background:var(--stone-925);
        border-bottom:1px solid var(--line);
        padding:20px 24px;
        gap:18px;
        box-shadow:0 12px 24px rgba(0,0,0,0.08);
      }
      .menu-toggle{display:block}
    }

    /* ---------- Hero ---------- */
    .hero{padding:76px 0 40px;position:relative;overflow:hidden}
    .hero::before{
      content:"";position:absolute;inset:-20% -10% auto -10%;height:520px;
      background:radial-gradient(60% 60% at 50% 0%, var(--accent-dim), transparent 70%);
      pointer-events:none;
    }
    .eyebrow-row{display:flex;align-items:center;gap:10px;margin-bottom:22px}
    .dot-live{width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 4px rgba(22,163,74,0.18)}
    .eyebrow{font-size:13.5px;color:var(--stone-400)}
    .hero h1{
      font-size:clamp(34px,5vw,58px);
      font-weight:600;
      line-height:1.08;
      max-width:16ch;
    }
    .hero .sub{
      margin-top:22px;max-width:58ch;color:var(--stone-400);font-size:18px;
    }
    .hero-ctas{display:flex;gap:14px;margin-top:34px;flex-wrap:wrap}
    .hero-note{margin-top:16px;color:var(--stone-500);font-size:13.5px}

    /* ---------- Flow Tabs & Video Showcase ---------- */
    .flow{
      margin-top:64px;
      border:1px solid var(--line);
      border-radius:20px;
      background:linear-gradient(180deg, #ffffff, var(--stone-950));
      overflow:hidden;
      box-shadow:0 20px 40px -15px rgba(0,0,0,0.07), 0 1px 3px rgba(0,0,0,0.04);
    }
    .flow-tabs{
      display:flex;
      border-bottom:1px solid var(--line);
      overflow-x:auto;
      scrollbar-width:none;
      background:var(--stone-900);
    }
    .flow-tabs::-webkit-scrollbar{display:none}
    .flow-tab{
      flex:1;
      min-width:210px;
      text-align:left;
      background:none;
      border:none;
      cursor:pointer;
      padding:20px 22px;
      color:var(--stone-400);
      border-right:1px solid var(--line);
      font-family:'Inter',sans-serif;
      position:relative;
      transition:background .2s ease, color .2s ease;
    }
    .flow-tab:last-child{border-right:none}
    .flow-tab .k{
      font-family:'IBM Plex Mono',monospace;
      font-size:12px;
      color:var(--stone-500);
      display:block;
      margin-bottom:6px;
      transition:color .2s ease;
    }
    .flow-tab .t{
      color:var(--stone-50);
      font-weight:600;
      font-size:15.5px;
      display:block;
    }
    .flow-tab.active{
      color:var(--stone-50);
      background:#ffffff;
    }
    .flow-tab.active::after{
      content:"";
      position:absolute;
      left:0;
      right:0;
      bottom:-1px;
      height:2px;
      background:var(--accent);
    }
    .flow-tab.active .k{color:var(--accent)}

    .flow-body{padding:28px 24px 32px}
    .flow-desc{
      color:var(--stone-400);
      max-width:76ch;
      margin:0 0 24px;
      font-size:15.5px;
      line-height:1.6;
      min-height:48px;
    }

    /* Video 16:9 Adaptativo */
    .video-responsive{
      position:relative;
      width:100%;
      padding-bottom:56.25%; /* 16:9 */
      height:0;
      border-radius:14px;
      overflow:hidden;
      background:#000000;
      box-shadow:0 12px 30px rgba(0,0,0,0.08);
      border:1px solid var(--line);
    }
    .video-responsive iframe{
      position:absolute;
      top:0;
      left:0;
      width:100%;
      height:100%;
      border:0;
    }

    /* ---------- Features ---------- */
    .section-head{max-width:62ch;margin-bottom:52px}
    .section-head h2{font-size:clamp(26px,3.4vw,36px);font-weight:600}
    .section-head p{color:var(--stone-400);margin-top:14px;font-size:16.5px}
    .feat-grid{
      display:grid;grid-template-columns:repeat(3,1fr);gap:1px;
      background:var(--line);border:1px solid var(--line);border-radius:16px;
      overflow:hidden;box-shadow:0 4px 20px rgba(0,0,0,0.03);
    }
    @media (max-width:900px){.feat-grid{grid-template-columns:repeat(2,1fr)}}
    @media (max-width:600px){.feat-grid{grid-template-columns:1fr}}
    .feat{background:#ffffff;padding:30px 26px}
    .feat h3{font-size:17px;margin-bottom:10px}
    .feat p{color:var(--stone-400);font-size:14.5px;margin:0}
    .feat .idx{font-family:'IBM Plex Mono',monospace;color:var(--accent);font-size:12px;margin-bottom:14px;display:block}

    /* ---------- BIM split ---------- */
    .split{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
    @media (max-width:860px){.split{grid-template-columns:1fr;gap:40px}}
    .bim-diagram{
      border:1px solid var(--line);border-radius:16px;background:#ffffff;padding:28px;
      box-shadow:0 4px 20px rgba(0,0,0,0.03);
    }
    .bim-row{display:flex;align-items:center;gap:14px;padding:14px 0;border-bottom:1px solid var(--line)}
    .bim-row:last-child{border-bottom:none}
    .bim-file{
      font-family:'IBM Plex Mono',monospace;font-size:12.5px;color:var(--stone-50);
      background:var(--stone-850);border:1px solid var(--line);padding:6px 10px;border-radius:8px;white-space:nowrap;
    }
    .bim-arrow{color:var(--stone-500)}
    .bim-out{color:var(--stone-400);font-size:13.5px}
    .split h2{font-size:clamp(24px,3vw,32px);font-weight:600;max-width:14ch}
    .split p.lead{color:var(--stone-400);margin-top:16px;font-size:16.5px;max-width:48ch}
    .checklist{margin-top:24px;display:flex;flex-direction:column;gap:12px;padding:0}
    .checklist li{list-style:none;display:flex;gap:10px;color:var(--stone-200);font-size:15px}
    .checklist li::before{content:"→";color:var(--accent);font-family:'IBM Plex Mono',monospace}

    /* ---------- METROKUBIKO PLATFORM INTEGRATION SECTION ---------- */
    .integration-box{
      background:linear-gradient(180deg, #fffbf7, #f7f3ee);
      border:1px solid #edd5c5;
      border-radius:24px;
      padding:48px 40px;
      position:relative;
      overflow:hidden;
      box-shadow:0 24px 48px -15px rgba(0,0,0,0.07);
    }
    .integration-box::after{
      content:"";position:absolute;top:-40%;right:-10%;width:420px;height:420px;
      background:radial-gradient(circle, rgba(234,88,12,0.08), transparent 70%);
      pointer-events:none;
    }
    .int-header{
      display:flex;
      justify-content:space-between;
      align-items:flex-start;
      gap:24px;
      flex-wrap:wrap;
      margin-bottom:36px;
    }
    .int-title-area{max-width:640px}
    .int-badge{
      display:inline-flex;align-items:center;gap:8px;
      font-family:'IBM Plex Mono',monospace;font-size:12px;
      background:var(--accent-dim);color:var(--accent);border:1px solid rgba(234,88,12,0.3);
      padding:4px 12px;border-radius:999px;margin-bottom:14px;
    }
    .int-title-area h2{font-size:clamp(24px,3.2vw,34px);font-weight:600;line-height:1.2}
    .int-title-area p{color:var(--stone-400);font-size:16px;margin-top:12px}
    
    .int-modules-grid{
      display:grid;
      grid-template-columns:repeat(4, 1fr);
      gap:16px;
      margin-top:28px;
    }
    @media (max-width:960px){.int-modules-grid{grid-template-columns:repeat(2,1fr)}}
    @media (max-width:540px){.int-modules-grid{grid-template-columns:1fr}}

    .int-card{
      background:#ffffff;
      border:1px solid var(--line);
      border-radius:14px;
      padding:22px;
      display:flex;
      flex-direction:column;
      gap:12px;
      transition:transform .2s ease, border-color .2s ease, box-shadow .2s ease;
      box-shadow:0 2px 8px rgba(0,0,0,0.03);
    }
    .int-card:hover{
      transform:translateY(-2px);
      border-color:var(--stone-400);
      box-shadow:0 8px 20px rgba(0,0,0,0.06);
    }
    .int-card .i-icon{
      width:40px;
      height:40px;
      border-radius:9px;
      background:#fff2ea;
      border:1px solid #fcd9c4;
      color:var(--accent);
      display:flex;
      align-items:center;
      justify-content:center;
      flex-shrink:0;
    }
    .int-card .i-icon svg{
      width:18px;
      height:18px;
      fill:currentColor;
      display:block;
    }
    .int-card h4{
      font-size:15px;
      color:var(--stone-50);
      margin:0;
    }
    .int-card p{
      color:var(--stone-400);
      font-size:13px;
      margin:0;
      line-height:1.5;
    }

    .int-bottom-bar{
      margin-top:32px;
      padding-top:24px;
      border-top:1px solid var(--line);
      display:flex;
      justify-content:space-between;
      align-items:center;
      flex-wrap:wrap;
      gap:16px;
    }
    .int-points{
      display:flex;gap:24px;flex-wrap:wrap;
    }
    .int-point{
      display:flex;align-items:center;gap:8px;
      font-family:'IBM Plex Mono',monospace;
      font-size:12.5px;
      color:var(--stone-400);
    }
    .int-point span{color:var(--ok)}

    /* ---------- Pricing Plans ---------- */
    .plans{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
    @media (max-width:900px){.plans{grid-template-columns:1fr;max-width:420px;margin:0 auto}}
    .plan{
      border:1px solid var(--line);border-radius:16px;padding:30px 26px;background:#ffffff;
      display:flex;flex-direction:column;
      box-shadow:0 2px 8px rgba(0,0,0,0.03);
    }
    .plan.featured{
      border-color:var(--accent);background:linear-gradient(180deg, #fffaf5, #ffffff);
      position:relative;
      box-shadow:0 12px 30px -10px rgba(234,88,12,0.15);
    }
    .plan-badge{
      position:absolute;top:-13px;left:26px;background:var(--accent);color:#ffffff;
      font-size:11.5px;font-weight:700;padding:4px 10px;border-radius:999px;font-family:'IBM Plex Mono',monospace;
    }
    .plan h3{font-size:19px}
    .plan .price{margin-top:14px;display:flex;align-items:baseline;gap:6px}
    .plan .price .num{font-family:'Space Grotesk',sans-serif;font-size:38px;font-weight:600;color:var(--stone-50)}
    .plan .price .per{color:var(--stone-500);font-size:14px}
    .plan .desc{color:var(--stone-400);font-size:14px;margin-top:10px;min-height:42px}
    .plan .includes{font-family:'IBM Plex Mono',monospace;font-size:11.5px;color:var(--stone-500);margin-top:18px;padding-top:16px;border-top:1px solid var(--line)}
    .plan ul{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:11px;flex:1}
    .plan li{display:flex;justify-content:space-between;gap:12px;font-size:13.5px;color:var(--stone-200)}
    .plan li .v{color:var(--stone-400);font-family:'IBM Plex Mono',monospace;font-size:12.5px;text-align:right}
    .plan .btn{margin-top:24px;width:100%}

    /* ---------- CTA / waitlist ---------- */
    .cta-section{
      border-top:1px solid var(--line);border-bottom:1px solid var(--line);
      background:radial-gradient(70% 100% at 50% 0%, #fff2ea, var(--stone-950));
    }
    .cta-inner{text-align:center;max-width:640px;margin:0 auto}
    .cta-inner h2{font-size:clamp(26px,4vw,38px)}
    .cta-inner p{color:var(--stone-400);margin-top:14px;font-size:16.5px}
    .cta-actions{margin-top:32px;display:flex;justify-content:center}
    .waitlist-note{margin-top:16px;color:var(--stone-500);font-size:13px}

    /* ---------- MODAL STYLES ---------- */
    .modal-backdrop{
      position:fixed;
      inset:0;
      z-index:999;
      background:rgba(20, 18, 16, 0.65);
      backdrop-filter:blur(6px);
      display:none;
      align-items:center;
      justify-content:center;
      padding:20px;
      opacity:0;
      transition:opacity .25s ease;
    }
    .modal-backdrop.open{
      display:flex;
      opacity:1;
    }
    .modal-card{
      background:#ffffff;
      border:1px solid var(--line);
      border-radius:20px;
      max-width:540px;
      width:100%;
      position:relative;
      box-shadow:0 24px 60px rgba(0,0,0,0.22);
      padding:32px 30px;
      transform:scale(0.96) translateY(8px);
      transition:transform .25s ease;
      max-height:92vh;
      overflow-y:auto;
    }
    .modal-backdrop.open .modal-card{
      transform:scale(1) translateY(0);
    }
    .modal-close{
      position:absolute;
      top:18px;
      right:18px;
      width:34px;
      height:34px;
      border-radius:50%;
      border:1px solid var(--line);
      background:var(--stone-900);
      color:var(--stone-400);
      cursor:pointer;
      font-size:20px;
      line-height:1;
      display:flex;
      align-items:center;
      justify-content:center;
      transition:all .15s ease;
    }
    .modal-close:hover{
      background:var(--stone-800);
      color:var(--stone-50);
    }
    .modal-header{margin-bottom:22px}
    .modal-eyebrow{
      font-size:11.5px;
      color:var(--accent);
      text-transform:uppercase;
      letter-spacing:0.04em;
      display:inline-block;
      margin-bottom:6px;
    }
    .modal-header h3{font-size:22px;color:var(--stone-50)}
    .modal-header p{color:var(--stone-400);font-size:14px;margin-top:6px}

    .modal-form{display:flex;flex-direction:column;gap:14px}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    @media (max-width:560px){
      .form-row{grid-template-columns:1fr;gap:14px}
      .modal-card{padding:26px 20px}
    }
    .form-group{display:flex;flex-direction:column;gap:5px;text-align:left}
    .form-group label{
      font-size:12.5px;
      font-weight:600;
      color:var(--stone-200);
    }
    .form-group label .opt{font-weight:400;color:var(--stone-500);font-size:11.5px}
    .form-group input,
    .form-group select{
      background:#ffffff;
      border:1px solid var(--stone-700);
      color:var(--stone-50);
      padding:10px 13px;
      border-radius:8px;
      font-size:14px;
      font-family:'Inter',sans-serif;
      transition:border-color .15s ease, box-shadow .15s ease;
      outline:none;
      width:100%;
    }
    .form-group input:focus,
    .form-group select:focus{
      border-color:var(--accent);
      box-shadow:0 0 0 3px var(--accent-dim);
    }
    .form-group select{
      appearance:none;
      background-image:url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%2378716c' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
      background-repeat:no-repeat;
      background-position:right 10px center;
      background-size:14px;
      padding-right:32px;
      cursor:pointer;
    }
    .hp-field{
      position:absolute !important;
      left:-9999px !important;
      top:-9999px !important;
      opacity:0 !important;
      pointer-events:none !important;
      height:0 !important;
      width:0 !important;
      overflow:hidden !important;
    }
    .btn-block{width:100%;margin-top:8px}
    .modal-error{
      display:none;
      margin:8px 0 0;
      color:#dc2626;
      font-family:'IBM Plex Mono',monospace;
      font-size:12.5px;
      text-align:center;
    }
    .modal-success{
      text-align:center;
      padding:16px 8px;
      display:none;
      flex-direction:column;
      align-items:center;
      gap:12px;
    }
    .success-icon{
      width:52px;
      height:52px;
      border-radius:50%;
      background:#dcfce7;
      color:var(--ok);
      display:flex;
      align-items:center;
      justify-content:center;
      font-size:24px;
      font-weight:700;
    }
    .modal-success h4{font-size:20px}
    .modal-success p{color:var(--stone-400);font-size:14px;margin:0 0 8px}

    /* ---------- Footer ---------- */
    footer{padding:56px 0 40px;background:var(--stone-900);border-top:1px solid var(--line)}
    .foot-top{display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap}
    .foot-brand{max-width:360px}
    .foot-brand img{height:24px;margin-bottom:16px;filter:invert(1) hue-rotate(180deg)}
