                </div>
              </div>

              <div class="demo-bar-right">
                <div class="demo-timer" id="demo-timer-num">0.0s / 7.2s</div>
                <button type="button" class="btn-playback" id="demo-playback-btn" aria-label="Controlar animación">
                  <span id="playback-icon">❚❚</span>
                  <span id="playback-text">Pausar</span>
